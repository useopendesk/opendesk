---
import Layout from '../layouts/Layout.astro';
import Showcase from '../components/features/Showcase.astro';
import LiveWidget from '../components/home/LiveWidget.astro';
import InboxScreen from '../components/features/screens/InboxScreen.astro';
import OllieScreen from '../components/features/screens/OllieScreen.astro';
import KbScreen from '../components/features/screens/KbScreen.astro';
import AutomationsScreen from '../components/features/screens/AutomationsScreen.astro';
import ReportsScreen from '../components/features/screens/ReportsScreen.astro';
import ApiScreen from '../components/features/screens/ApiScreen.astro';
import { LINKS } from '../lib/site';

const stops: [string, string][] = [
  ['inbox', 'Inbox'],
  ['chat', 'Live chat'],
  ['ai', 'Ollie'],
  ['knowledge-base', 'Knowledge base'],
  ['automations', 'Automations and SLAs'],
  ['reports', 'Reports'],
  ['api', 'API'],
];
const guide = (path: string) => `${LINKS.docs}${path}`;
---
<Layout cta={{ painting: 'sunflowers' }} title="Features" description="Shared inboxes, live chat, AI drafts and translation, a knowledge base, automations, SLA policies, reports, a public REST API, webhooks and realtime presence. Every feature in opendesk, on the cloud and self-hosted.">
  <section class="container-page pt-16 text-center md:pt-24">
    <div class="label inline-flex items-center gap-2"><span class="dot"></span>Features</div>
    <h1 class="mx-auto mt-6 max-w-[14ch] text-balance text-[44px] font-semibold leading-[0.98] tracking-[-0.05em] text-fg sm:text-[64px] lg:text-[80px]">Everything a support team does.</h1>
    <p class="lede mx-auto mt-6 max-w-[520px]">Every feature on every plan, on the cloud or on your own servers.</p>
    <nav class="mx-auto mt-10 flex max-w-[760px] flex-wrap justify-center gap-2" aria-label="Features">
      {stops.map(([id, label]) => (
        <a href={`#${id}`} class="inline-flex h-9 items-center rounded-full bg-surface-2 px-4 text-[14px] text-body ring-1 ring-line transition-colors hover:bg-bg hover:text-fg">{label}</a>
      ))}
    </nav>
  </section>

  <Showcase id="inbox" label="Shared inbox" title="One queue for every mailbox." body="Email from every address you answer becomes a ticket with an owner and a status." painting="plains" focus="50% 40%" w={1280} h={804} alt="The opendesk inbox: tickets from every mailbox in one list, new ones arriving." href={guide('/guides/inbox-and-tickets/')}>
    <InboxScreen />
  </Showcase>

  <Showcase id="chat" label="Live chat" title="Chat that knows when to step aside." body="Ollie answers first. A person joins the moment someone asks." painting="cumulus-fields" focus="50% 60%" alt="The opendesk chat widget, live. Try it.">
    <div class="relative mx-auto h-[640px] w-full max-w-[480px]"><LiveWidget scene="chat" autoplay /></div>
  </Showcase>

  <Showcase id="ai" label="Ollie" title="AI that writes like your team." body="Drafts, summaries and translations, from your own replies and articles." painting="pink-valley" focus="50% 50%" w={1280} h={804} alt="A ticket with Ollie's drafted reply, ready to send." href={guide('/guides/ai/')}>
    <OllieScreen />
  </Showcase>

  <Showcase id="knowledge-base" label="Knowledge base" title="Answers customers find themselves." body="Write an article once. It powers your help center and Ollie." painting="lake" focus="50% 55%" w={1280} h={804} alt="The knowledge base: articles in collections, one open in the editor." href={guide('/guides/knowledge-base/')}>
    <KbScreen />
  </Showcase>

  <Showcase id="automations" label="Automations and SLAs" title="Rules that run before anyone looks." body="Route, tag and prioritise on arrival, with targets that warn before they break." painting="golden-field" focus="50% 55%" w={1280} h={804} alt="An automation rule: when a ticket arrives that mentions a refund, tag it, assign billing and raise the priority." href={guide('/guides/automations/')}>
    <AutomationsScreen />
  </Showcase>

  <Showcase id="reports" label="Reports" title="The numbers support runs on." body="Volume, reply times, SLAs and satisfaction, by channel and by agent." painting="savanna" focus="50% 60%" w={1280} h={804} alt="The reports overview: tickets, first reply time, SLA and satisfaction over the last 30 days." href={guide('/guides/reports/')}>
    <ReportsScreen />
  </Showcase>

  <Showcase id="api" label="API and webhooks" title="The API is the product." body="Everything the app does, over REST, with signed webhooks for every event." painting="blue-ridges" focus="50% 60%" w={1280} h={804} alt="API keys and webhook deliveries in opendesk settings." href={`${LINKS.docs}/api/`}>
    <ApiScreen />
  </Showcase>
</Layout>

<script>
  import { initLive } from '../lib/live';
  initLive();
</script>
