---
import Layout from '../layouts/Layout.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import PricingHero from '../components/pricing/PricingHero.astro';
import CompareTable from '../components/pricing/CompareTable.astro';
import UsageStage from '../components/pricing/UsageStage.astro';
import { PRO_PRICE, AI_ALLOWANCE, AI_TOP_UP, AI_MARKUP, AUTO_RECHARGE, TYPICAL_DRAFT, MODELS, model, usd, usdCall, usdPerMTok } from '../lib/pricing';

const included = [
  ['inbox', 'Shared inboxes and live chat', 'Every mailbox and the chat widget in one queue.'],
  ['book', 'Help center', 'A public knowledge base customers search by meaning.'],
  ['sparkles', 'Ollie', 'Drafts, summaries, triage and answers, on every plan.'],
  ['languages', '13 languages', 'The widget and help center, and translation both ways.'],
  ['zap', 'Automations and SLAs', 'Rules on arrival and targets that warn before they break.'],
  ['chart', 'Reports and CSAT', 'Medians, breaches and satisfaction by day, channel and agent.'],
  ['braces', 'API, webhooks, realtime', 'The same REST API the app uses, with scoped keys.'],
  ['shield', 'Teams, roles, 2FA, audit log', 'The security controls, written down on /security.'],
] as const;

const haiku = model('anthropic/claude-haiku-5.5');
const topUpRange = `${usd(AI_TOP_UP.minUsd)} to ${usd(AI_TOP_UP.maxUsd)}`;

const faq = [
  {
    q: 'Who counts as a user on Pro?',
    a: 'Owners, admins and agents: the people who can reply to customers. Viewers, who can read but not change anything, are free. Adding or removing a user is prorated.',
  },
  {
    q: 'Is the Free plan really free forever?',
    a: `Yes, for any organization. It has every feature, with one mailbox, one team member and ${usd(AI_ALLOWANCE.free)} of AI usage a month. Upgrade when your team grows.`,
  },
  {
    q: 'What happens if I downgrade?',
    a: 'Nothing is deleted. Your existing mailboxes and members stay; you just cannot add new ones until the workspace is within the Free limits.',
  },
  {
    q: 'How is AI usage priced?',
    a: `By what each call really uses. A call costs the provider’s price for its tokens times ${AI_MARKUP}, so it depends on the model you choose and how long the thread is: a typical draft reply costs about ${usdCall(haiku.typicalDraft)} on ${haiku.name}, the default model. Free includes ${usd(AI_ALLOWANCE.free)} of AI usage a month, and Pro ${usd(AI_ALLOWANCE.perSeat)} per paid user, pooled across the workspace. When the allowance runs out you can add any amount of AI usage, from ${topUpRange}, which never expires, or turn on auto-recharge. A failed AI call costs nothing.`,
  },
  {
    q: 'Can I use my own AI key on Cloud?',
    a: 'Yes. Owners and admins can connect an OpenRouter, Anthropic or OpenAI-compatible key in Settings. AI calls then run on that key and cost nothing on opendesk; triage and automation decisions still use a little of the AI balance.',
  },
  {
    q: 'Is my data used to train AI models?',
    a: 'No. Customer content is sent to the AI provider only to perform the feature you asked for, and it is not used to train models. Admins can turn AI off for the whole workspace.',
  },
  {
    q: 'Can I buy as a business?',
    a: 'Paid plans and AI top-ups are for businesses. Add your company’s legal name, billing address and tax ID at checkout, and they appear on every invoice. Prices are in US dollars and exclude taxes: where we do not charge tax, your business accounts for any tax due in its own country, for example under the reverse charge.',
  },
  {
    q: 'Is self-hosted really free?',
    a: 'Yes. opendesk is Apache-2.0 licensed. Self-hosted has every feature, no limits and no license key. Bring your own AI key, or point it at a local model. You pay only for your own servers.',
  },
];

const usageFacts = [
  { icon: 'chart', title: 'Charged on real usage', body: `Each call costs the provider’s price for the tokens it used, times ${AI_MARKUP}. A pricier model or a longer thread costs more, a short one less.`, foot: 'A failed call costs nothing' },
  { icon: 'sparkles', title: 'AI top-ups', body: `Add any amount of AI usage, dollar for dollar, on Free or Pro. It never expires and is spent after the monthly allowance.`, foot: topUpRange },
  { icon: 'refresh', title: 'Auto-recharge', body: `Off by default. When the balance falls below your threshold, it adds the amount you choose on your saved card, ${usd(AUTO_RECHARGE.amountUsd)} below ${usd(AUTO_RECHARGE.thresholdUsd)} unless you change it, up to a monthly limit you set. Each recharge gets an invoice.`, foot: 'So Ollie never pauses' },
  { icon: 'key', title: 'Your own AI key', body: 'Connect an OpenRouter, Anthropic or OpenAI-compatible key and its AI calls cost $0 here. Triage decisions still use a little.', foot: 'Self-hosted always runs on its own key' },
] as const;
---
<Layout cta={{ painting: 'golden-field' }} preload={{ name: 'green-valley', sizes: '100vw' }} title="Pricing" description={`opendesk is free forever for one mailbox and one user, $${PRO_PRICE} per user per month for unlimited everything, and free and unlimited when you self-host. Every feature on every plan.`} jsonLd={{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }}>
  <PricingHero />
  <p class="container-page mt-5 text-[14px] text-muted">Need SSO enforcement, an SLA or invoicing? <a href="/contact/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Contact us</a>.</p>

  <!-- Included on every plan -->
  <section id="plans" class="container-page mt-24 scroll-mt-24 md:mt-32">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <h2 class="max-w-[14ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[52px]">Every plan has every feature.</h2>
      <div class="lg:pb-2">
        <p class="lede max-w-[520px]">Nothing is held back for a higher tier. The free workspace runs the same product as a team of fifty.</p>
        <a href="/features/" class="link-arrow mt-4">See every feature<Icon name="arrowRight" size={14} /></a>
      </div>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-[22px] bg-line ring-1 ring-line sm:grid-cols-2 lg:grid-cols-4 md:mt-14">
      {included.map(([icon, t, d]) => (
        <div class="bg-surface-2 p-6 md:p-7">
          <span class="flex size-9 items-center justify-center rounded-[10px] bg-bg text-fg ring-1 ring-line"><Icon name={icon} size={16} /></span>
          <h3 class="mt-5 text-[15.5px] font-semibold tracking-[-0.015em] text-fg">{t}</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-muted">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- AI usage -->
  <section id="ai-usage" class="container-page mt-28 scroll-mt-24 md:mt-40">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <div>
        <div class="label flex items-center gap-2 text-[var(--c-violet)]">AI usage</div>
        <h2 class="mt-5 max-w-[14ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[52px]">Pay for AI by what it does.</h2>
      </div>
      <p class="lede max-w-[520px] lg:pb-2">Free includes {usd(AI_ALLOWANCE.free)} of AI usage a month. Pro includes {usd(AI_ALLOWANCE.perSeat)} per paid user, pooled so the whole team draws from one balance. Each call costs what it used on the model you choose.</p>
    </div>
    <div class="mt-10 grid gap-3 md:mt-14 lg:grid-cols-12">
      <div class="lg:col-span-7"><UsageStage /></div>
      <div class="flex flex-col rounded-[22px] bg-bg ring-1 ring-line lg:col-span-5">
        <div class="flex items-baseline justify-between gap-3 border-b border-line px-5 py-4 sm:px-6">
          <span class="text-[14px] font-medium text-fg">Price by model</span>
          <span class="text-[12.5px] text-subtle">usage-based</span>
        </div>
        <table class="w-full text-left text-[13px] sm:text-[14px]">
          <caption class="sr-only">What each AI model costs on opendesk Cloud, per 1M tokens and for a typical draft reply</caption>
          <thead>
            <tr class="border-b border-line-soft text-[11.5px] text-subtle">
              <th scope="col" class="py-2.5 pl-4 pr-2 font-normal sm:pl-6">Model</th>
              <th scope="col" class="px-2 py-2.5 text-right font-normal sm:whitespace-nowrap">In / out per 1M tokens</th>
              <th scope="col" class="whitespace-nowrap py-2.5 pl-2 pr-4 text-right font-normal sm:pr-6">Typical draft</th>
            </tr>
          </thead>
          <tbody>
            {MODELS.map((m) => (
              <tr class="border-b border-line-soft">
                <th scope="row" class="py-2.5 pl-4 pr-2 font-normal sm:pl-6 lg:py-3">
                  <div class="text-body">{m.name}</div>
                  <div class="mt-0.5 flex items-center gap-1.5 text-[11.5px] text-subtle">{m.vendor}{m.note && <span class={`pill ${m.note === 'Default' ? 't-violet' : 't-grey'} !h-4 !px-1.5 !text-[10px]`}>{m.note}</span>}</div>
                </th>
                <td class="whitespace-nowrap px-2 py-2.5 text-right font-mono text-[11.5px] tabular-nums text-muted sm:text-[12.5px] lg:py-3"><span class="text-fg">{usdPerMTok(m.pays.input)}</span> / <span class="text-fg">{usdPerMTok(m.pays.output)}</span></td>
                <td class="whitespace-nowrap py-2.5 pl-2 pr-4 text-right font-mono text-[11.5px] tabular-nums text-fg sm:pr-6 sm:text-[12.5px] lg:py-3">{usdCall(m.typicalDraft)}</td>
              </tr>
            ))}
            <tr class="border-b border-line-soft">
              <th scope="row" class="py-2.5 pl-4 pr-2 font-normal sm:pl-6 lg:py-3">
                <div class="text-body">Your own AI key</div>
                <div class="mt-0.5 text-[11.5px] text-subtle">Any model, paid to your provider</div>
              </th>
              <td class="whitespace-nowrap px-2 py-2.5 text-right font-mono text-[11.5px] tabular-nums text-muted sm:text-[12.5px] lg:py-3">$0 / $0</td>
              <td class="whitespace-nowrap py-2.5 pl-2 pr-4 text-right font-mono text-[11.5px] tabular-nums text-muted sm:pr-6 sm:text-[12.5px] lg:py-3">$0</td>
            </tr>
          </tbody>
        </table>
        <p class="mt-auto px-4 py-4 text-[12px] leading-relaxed text-subtle sm:px-6">Prices on opendesk Cloud, provider cost × {AI_MARKUP}. They follow each provider’s list price. A typical draft is {TYPICAL_DRAFT.input.toLocaleString('en-US')} tokens in and {TYPICAL_DRAFT.output} out. Search and indexing are free.</p>
      </div>
    </div>
    <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {usageFacts.map((f) => (
        <div class="flex flex-col rounded-[18px] bg-surface-2 p-6 ring-1 ring-line">
          <Icon name={f.icon} size={17} class="text-fg" />
          <h3 class="mt-4 text-[15.5px] font-semibold tracking-[-0.015em] text-fg">{f.title}</h3>
          <p class="mt-1.5 flex-1 text-[14px] leading-relaxed text-muted">{f.body}</p>
          <div class="mt-4 text-[12.5px] text-subtle">{f.foot}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Compare -->
  <section id="compare" class="container-page mt-28 scroll-mt-24 md:mt-40">
    <div class="grid gap-6 lg:grid-cols-[1.1fr_1fr] lg:items-end">
      <h2 class="max-w-[16ch] text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[52px]">The plans side by side.</h2>
      <p class="lede max-w-[520px] lg:pb-2">What changes is how many mailboxes and people you have, how AI is paid for, and whose servers it runs on.</p>
    </div>
    <div class="mt-10 md:mt-14"><CompareTable /></div>
  </section>

  <!-- FAQ -->
  <section id="questions" class="container-page mt-28 scroll-mt-24 md:mt-40">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <div>
        <h2 class="text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[48px]">Pricing, plainly.</h2>
        <p class="mt-4 max-w-[34ch] text-[15px] leading-relaxed text-muted">Something else? <a href="/contact/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Write to us</a>, a person answers.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

</Layout>
