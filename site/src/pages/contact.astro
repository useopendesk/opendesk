---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import ContactThread from '../components/pages/ContactThread.astro';
import ContactComposer from '../components/pages/ContactComposer.astro';
import WidgetDemo from '../components/pages/WidgetDemo.astro';
import type { ContactChannel } from '../components/pages/types';
import { EMAIL, LINKS, COMPANY } from '../lib/site';

const channels: ContactChannel[] = [
  {
    id: 'sales', icon: 'chat', title: 'Sales and general', body: 'Plans, SSO, SLAs, invoicing, partnerships, or anything else.', email: EMAIL,
    subject: 'opendesk for our team', hint: 'Tell us about your team, how many people answer customers, and what you need to know.',
  },
  {
    id: 'support', icon: 'heart', title: 'Customer support', body: 'Help with your opendesk Cloud workspace.', email: EMAIL,
    subject: 'Help with our workspace', hint: 'Tell us your workspace, what you expected and what happened instead. A screenshot helps.',
  },
  {
    id: 'security', icon: 'shield', title: 'Security', body: 'Report a vulnerability privately. Please do not open a public issue.', email: EMAIL,
    subject: 'Vulnerability report', hint: 'Describe the issue, the steps to reproduce it and the impact you see.',
    note: 'Please report it privately to this address and do not open a public issue.',
  },
  {
    id: 'privacy', icon: 'lock', title: 'Privacy', body: 'Data requests, deletion and questions about this policy.', email: EMAIL,
    subject: 'Data request', hint: 'Tell us what you would like, such as a copy of your data or its deletion, and the email address on the account.',
  },
];
---
<Layout cta={{ painting: 'pink-valley' }} title="Contact" description="Talk to the opendesk team about plans, support, security or privacy, or join the project on GitHub.">
  <!-- Opening: the words on the left, a conversation on the right. -->
  <section class="px-2 pt-2 md:px-3 md:pt-3">
    <div class="grid gap-2 lg:min-h-[calc(100dvh-88px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
      <div class="flex flex-col justify-between rounded-[22px] bg-surface-2 px-6 py-10 ring-1 ring-line md:rounded-[28px] md:px-12 md:py-14 lg:px-16">
        <div class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-muted">Contact</div>
        <div class="py-12 lg:py-0">
          <h1 class="max-w-[10ch] text-[52px] font-semibold leading-[0.98] tracking-[-0.05em] text-fg sm:text-[72px] xl:text-[96px]">Talk to a person.</h1>
          <p class="lede mt-7 max-w-[480px]">One address reaches the people who build opendesk, whatever it is about. Sales, support, security, privacy and legal all go to {EMAIL}.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row">
            <a href="#write" class="btn btn-lg btn-primary"><Icon name="squarePen" size={15} />Write to us</a>
            <a href={LINKS.githubIssues} class="btn btn-lg btn-ghost"><Icon name="github" size={15} />Open an issue</a>
          </div>
        </div>
        <a href={`mailto:${EMAIL}`} class="group flex items-center justify-between gap-4 border-t border-line pt-6 font-mono text-fg">
          <span class="flex flex-col"><span class="text-[10.5px] uppercase tracking-[0.08em] text-subtle">Email</span><span class="text-[15px] underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-line-strong">{EMAIL}</span></span>
          <Icon name="arrowUpRight" size={15} class="text-subtle transition-transform group-hover:-translate-y-px group-hover:translate-x-px" />
        </a>
      </div>
      <ContactThread class="min-h-[460px] lg:min-h-0" />
    </div>
  </section>

  <!-- Starting a message. -->
  <section id="write" class="container-page mt-24 scroll-mt-24 md:mt-32">
    <div class="grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-end">
      <h2 class="text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[48px]">What is it about?</h2>
      <p class="max-w-[52ch] text-[15.5px] leading-relaxed text-muted md:pb-1.5">Everything goes to one inbox. Pick a topic and the subject line tells us who should answer, so your note never waits in the wrong queue.</p>
    </div>
    <ContactComposer channels={channels} class="mt-10" />

    <!-- GitHub, for self-hosters and contributors. -->
    <div class="mt-3 grid gap-6 rounded-[22px] bg-[#0a0a0a] p-6 text-white ring-1 ring-white/10 md:p-10 lg:grid-cols-[1.1fr_1fr] lg:items-center dark:bg-surface dark:ring-line">
      <div class="flex gap-5">
        <span class="flex size-11 shrink-0 items-center justify-center rounded-[12px] bg-white text-[#0a0a0a]"><Icon name="github" size={20} /></span>
        <div>
          <h2 class="text-[22px] font-semibold tracking-[-0.025em] md:text-[26px]">Self-hosting or contributing?</h2>
          <p class="mt-2 max-w-[52ch] text-[15px] leading-relaxed text-white/65">Questions about running opendesk yourself and bug reports are best on GitHub, where others can find the answer.</p>
        </div>
      </div>
      <div class="grid gap-2 sm:grid-cols-3">
        {[
          ['bug', 'Open an issue', LINKS.githubIssues],
          ['download', 'Releases', LINKS.githubReleases],
          ['book', 'Self-hosting docs', `${LINKS.docs}/self-hosting/`],
        ].map(([i, t, h]) => (
          <a href={h} class="group flex items-center gap-2.5 rounded-[12px] bg-white/[0.06] px-4 py-3.5 text-[14px] text-white ring-1 ring-white/10 transition-colors hover:bg-white/[0.12]">
            <Icon name={i as 'bug'} size={15} class="text-white/60" />{t}
            <Icon name="arrowUpRight" size={13} class="ml-auto text-white/40 transition-transform group-hover:-translate-y-px group-hover:translate-x-px" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The widget, as a demo. -->
  <section class="container-page mt-24 md:mt-32">
    <div class="grid gap-6 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:items-end">
      <h2 class="text-[36px] font-semibold leading-[1.02] tracking-[-0.045em] text-fg md:text-[48px]">Or try the chat widget.</h2>
      <p class="max-w-[60ch] text-[15.5px] leading-relaxed text-muted md:pb-1.5">This is the opendesk widget your customers would see, running on a demo shop. It answers from sample articles inside your browser and never reaches our team, so for a person, write to {EMAIL}.</p>
    </div>
    <WidgetDemo class="mt-10" />
  </section>

  <!-- Who we are, to close. -->
  <section class="container-page mt-24 pb-4 md:mt-32">
    <div class="font-mono text-[11.5px] uppercase tracking-[0.08em] text-muted">Still here?</div>
    <a href={`mailto:${EMAIL}`} class="group mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-[34px] font-semibold leading-[1] tracking-[-0.05em] text-fg sm:text-[56px] lg:text-[96px]">
      <span class="underline decoration-line-strong decoration-2 underline-offset-[0.12em] transition-colors group-hover:decoration-fg">{EMAIL}</span>
      <span class="inline-flex size-12 items-center justify-center rounded-full bg-fg text-bg transition-transform group-hover:translate-x-1 lg:size-20"><Icon name="arrowRight" size={28} /></span>
    </a>
    <div class="mt-14 grid gap-x-10 gap-y-6 border-t border-line pt-8 md:mt-20 md:grid-cols-4">
      <div>
        <div class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Company</div>
        <div class="mt-2 text-[15px] font-semibold tracking-[-0.015em] text-fg">{COMPANY.legalName}</div>
        <div class="mt-0.5 text-[14px] text-muted">{COMPANY.address}</div>
        <div class="mt-0.5 text-[14px] text-muted">Registered in {COMPANY.registeredIn}, company number {COMPANY.number}</div>
      </div>
      <div>
        <div class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Legal</div>
        <a href={`mailto:${EMAIL}`} class="mt-2 block font-mono text-[13.5px] text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">{EMAIL}</a>
        <div class="mt-0.5 text-[14px] text-muted">Contracts and notices, to the same address.</div>
      </div>
      <div>
        <div class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Security</div>
        <a href="/security/" class="mt-2 inline-flex items-center gap-1.5 text-[15px] font-semibold tracking-[-0.015em] text-fg">How we protect your data<Icon name="arrowRight" size={13} /></a>
        <div class="mt-0.5 text-[14px] text-muted">And how reports are handled.</div>
      </div>
      <div>
        <div class="font-mono text-[10.5px] uppercase tracking-[0.1em] text-subtle">Policies</div>
        <div class="mt-2 flex gap-4 text-[14px]"><a href="/privacy/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Privacy</a><a href="/terms/" class="text-fg underline decoration-line-strong underline-offset-4 hover:decoration-fg">Terms</a></div>
      </div>
    </div>
  </section>
</Layout>
