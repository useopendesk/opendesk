---
/**
 * The head of a section: a label and a short headline on the left, one line
 * and an optional link on the right.
 */
import Icon from './Icon.astro';

interface Props {
  label: string;
  title: string;
  body?: string;
  href?: string;
  link?: string;
  class?: string;
}
const { label, title, body, href, link = 'Read the guide', class: className = '' } = Astro.props;
---
<div class={`grid gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-end lg:gap-16 ${className}`}>
  <div>
    <div class="label flex items-center gap-2"><span class="dot"></span>{label}</div>
    <h2 class="mt-5 max-w-[15ch] text-balance text-[34px] font-semibold leading-[1.03] tracking-[-0.045em] text-fg md:text-[52px]">{title}</h2>
  </div>
  <div class="lg:pb-2">
    {body && <p class="lede max-w-[440px]">{body}</p>}
    {href && <a href={href} class="link-arrow mt-4">{link}<Icon name="arrowRight" size={14} /></a>}
  </div>
</div>
