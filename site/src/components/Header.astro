---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, PRODUCT_NAV, LINKS } from '../lib/site';
import { getRepoStars } from '../lib/github';

const stars = await getRepoStars();
const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && path.startsWith(href);
const productActive = path.startsWith('/features/');
---
<header class="sticky top-0 z-50 border-b border-line" data-header>
  <!-- The blur sits on its own layer so the fixed mobile menu is not trapped inside the header box. -->
  <div class="absolute inset-0 -z-10 bg-bg/90 backdrop-blur-lg" aria-hidden="true"></div>
  <div class="container-page flex h-[60px] items-center gap-6">
    <a href="/" class="shrink-0 text-fg" aria-label="opendesk home">
      <Logo class="h-[20px] w-auto" />
    </a>

    <nav class="relative ml-4 hidden lg:flex items-center gap-1 text-[14px]" aria-label="Main">
      <div class="relative" data-mega>
        <button
          type="button"
          class={`nav-link inline-flex h-8 items-center gap-1.5 rounded-[5px] px-2.5 transition-colors hover:bg-surface hover:text-fg ${productActive ? 'text-fg' : 'text-muted'}`}
          aria-expanded="false"
          aria-controls="mega-product"
          data-mega-button
        >
          {productActive && <span class="dot !size-[5px]"></span>}
          Product
          <Icon name="chevronDown" size={13} class="mega-caret text-subtle transition-transform duration-200" />
        </button>
        <div id="mega-product" class="mega-panel absolute left-0 top-[calc(100%+12px)] w-[760px] opacity-0 pointer-events-none" data-mega-panel>
          <div class="grid grid-cols-3 gap-1 rounded-[16px] bg-bg p-2 ring-1 ring-line shadow-[0_24px_60px_-24px_rgb(0_0_0/0.25)]">
            {PRODUCT_NAV.map((it, i) => (
              <a href={it.href} class="mega-item group flex items-start gap-3 rounded-[10px] p-3.5 transition-colors hover:bg-surface-2" style={`--i:${i}`}>
                <span class="flex size-8 shrink-0 items-center justify-center rounded-[8px] bg-surface-2 text-subtle ring-1 ring-line transition-colors group-hover:bg-bg group-hover:text-fg"><Icon name={it.icon} size={15} /></span>
                <span class="min-w-0">
                  <span class="block text-[14px] font-medium text-fg">{it.title}</span>
                  <span class="mt-0.5 block text-[12.5px] leading-snug text-muted">{it.desc}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
      {NAV.map((n) => (
        <a
          href={n.href}
          class={`inline-flex h-8 items-center gap-1.5 rounded-[5px] px-2.5 transition-colors hover:bg-surface hover:text-fg ${isActive(n.href) ? 'text-fg' : 'text-muted'}`}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >{isActive(n.href) && <span class="dot !size-[5px]"></span>}{n.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <a
        href={LINKS.github}
        class="hidden md:inline-flex h-8 items-center gap-1.5 rounded-[5px] px-2.5 text-[13.5px] text-muted transition-colors hover:bg-surface hover:text-fg"
        aria-label={stars ? `opendesk on GitHub, ${stars} stars` : 'opendesk on GitHub'}
      >
        <Icon name="github" size={15} />
        {stars ? <span class="font-mono text-[12px] tabular-nums">{stars}</span> : <span>GitHub</span>}
      </a>
      <a
        href={LINKS.discord}
        class="hidden md:inline-flex size-8 items-center justify-center rounded-[5px] text-muted transition-colors hover:bg-surface hover:text-fg"
        aria-label="opendesk on Discord"
        title="Discord"
      >
        <Icon name="discord" size={16} />
      </a>
      <span class="mx-1.5 hidden md:block h-4 w-px bg-line"></span>
      <a href={LINKS.login} class="hidden sm:inline-flex h-8 items-center rounded-[5px] px-2.5 text-[14px] text-muted transition-colors hover:bg-surface hover:text-fg">Log in</a>
      <a href={LINKS.signup} class="btn btn-primary btn-sm ml-1">Start free</a>
      <button type="button" class="group lg:hidden ml-1 inline-flex size-9 items-center justify-center rounded-[5px] text-fg hover:bg-surface" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" data-menu-button>
        <Icon name="menu" size={20} class="group-aria-expanded:hidden" />
        <Icon name="x" size={20} class="hidden group-aria-expanded:block" />
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-menu lg:hidden fixed inset-x-0 top-[60px] bottom-0 overflow-y-auto bg-bg" data-menu>
    <nav class="container-page flex flex-col pb-10 pt-6" aria-label="Mobile">
      <div class="label mb-3">Product</div>
      <div class="grid grid-cols-2 gap-2">
        {PRODUCT_NAV.map((it) => (
          <a href={it.href} class="flex items-center gap-2.5 rounded-[12px] bg-surface-2 px-3.5 py-3.5 text-[14.5px] text-fg ring-1 ring-line active:bg-surface">
            <Icon name={it.icon} size={15} class="shrink-0 text-subtle" />{it.title}
          </a>
        ))}
      </div>
      <div class="mt-6 border-t border-line">
        {NAV.map((n) => (
          <a href={n.href} class="flex items-center justify-between border-b border-line py-4 text-[17px] font-medium tracking-[-0.01em] text-fg">{n.label}<Icon name="arrowRight" size={16} class="text-subtle" /></a>
        ))}
        <a href={LINKS.github} class="flex items-center justify-between border-b border-line py-4 text-[17px] font-medium tracking-[-0.01em] text-fg">GitHub<Icon name="github" size={16} class="text-subtle" /></a>
        <a href={LINKS.discord} class="flex items-center justify-between border-b border-line py-4 text-[17px] font-medium tracking-[-0.01em] text-fg">Discord<Icon name="discord" size={16} class="text-subtle" /></a>
      </div>
      <div class="mt-6 grid grid-cols-2 gap-2">
        <a href={LINKS.login} class="btn btn-ghost btn-lg">Log in</a>
        <a href={LINKS.signup} class="btn btn-primary btn-lg">Start free</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .mega-panel { transform: translateY(-4px); transition: opacity 180ms ease, transform 260ms cubic-bezier(0.16, 1, 0.3, 1); }
  [data-mega].is-open .mega-panel { opacity: 1; pointer-events: auto; transform: none; }
  [data-mega].is-open .mega-caret { transform: rotate(180deg); }
  /* Items settle in one after another as the menu opens. */
  .mega-item { opacity: 0; transform: translateY(4px); transition: opacity 220ms ease, transform 320ms cubic-bezier(0.16, 1, 0.3, 1), background-color 150ms ease; transition-delay: calc(var(--i) * 18ms); }
  [data-mega].is-open .mega-item { opacity: 1; transform: none; }
  .mobile-menu { visibility: hidden; opacity: 0; transform: translateY(-6px); transition: opacity 200ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 300ms; }
  .mobile-menu.is-open { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
  @media (prefers-reduced-motion: reduce) {
    .mega-panel, .mega-item, .mobile-menu { transition: none; transform: none; }
  }
</style>

<script>
  // Product menu: opens on hover or click, closes on Escape, click-away and leaving it.
  const mega = document.querySelector<HTMLElement>('[data-mega]');
  const megaButton = mega?.querySelector<HTMLButtonElement>('[data-mega-button]');
  const megaPanel = mega?.querySelector<HTMLElement>('[data-mega-panel]');
  let closeTimer: number | undefined;
  const setMega = (open: boolean) => {
    if (!mega || !megaButton) return;
    window.clearTimeout(closeTimer);
    mega.classList.toggle('is-open', open);
    megaButton.setAttribute('aria-expanded', String(open));
  };
  const hoverable = window.matchMedia('(hover: hover)').matches;
  if (mega && megaButton && megaPanel) {
    megaButton.addEventListener('click', (e) => {
      e.stopPropagation();
      setMega(megaButton.getAttribute('aria-expanded') !== 'true');
    });
    if (hoverable) {
      mega.addEventListener('pointerenter', () => setMega(true));
      mega.addEventListener('pointerleave', () => { closeTimer = window.setTimeout(() => setMega(false), 140); });
    }
    megaPanel.addEventListener('focusout', (e) => {
      if (!mega.contains(e.relatedTarget as Node)) setMega(false);
    });
  }

  // Mobile menu: closes on Escape, on click-away and when a link is followed.
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    if (!button || !menu) return;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.classList.toggle('is-open', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  button?.addEventListener('click', (e) => {
    e.stopPropagation();
    setOpen(button.getAttribute('aria-expanded') !== 'true');
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (mega?.classList.contains('is-open')) { setMega(false); megaButton?.focus(); }
    setOpen(false);
  });
  document.addEventListener('click', (e) => {
    if (menu && !menu.contains(e.target as Node)) setOpen(false);
    if (mega && !mega.contains(e.target as Node)) setMega(false);
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setOpen(false));
</script>
