---
/**
 * The opendesk iPhone app (ios/Opendesk) on its Unassigned inbox, drawn 1:1 at
 * the iPhone's 393 x 852 pt and scaled as one picture into the 292 x 600 box its
 * parent gives it (frame included). It takes a push on the scene's timeline
 * (`data-step`): the new chat lands at the top of the list as the banner drops.
 *
 * Every value follows the SwiftUI source: InboxView (GlassHeaderBar, WaitingBanner,
 * List of TicketRow), Indicators (StatusIcon, PriorityIcon, LiveChatBadge, WaitPill,
 * SLAPill, LabelChip), TabBar (ODTabBar with Ollie), Theme (colours, radii) and
 * Typography (Geist and Geist Mono). The status bar, Dynamic Island and the
 * notification are the system's, in SF.
 */
import Ollie from './Ollie.astro';

type Tone = 'red' | 'orange' | 'amber' | 'green' | 'teal' | 'blue' | 'violet' | 'gray';
type Status = 'open' | 'pending' | 'onHold';
type Priority = 'low' | 'normal' | 'high' | 'urgent';
interface Row {
  who: string;
  subject: string;
  preview: string;
  time: string;
  number: number;
  status: Status;
  priority: Priority;
  /** Ollie set the priority (custom.ai_decisions). */
  ai?: boolean;
  /** awaitingReply or a waiting chat: the name and subject read bolder. */
  unread?: boolean;
  chat?: boolean;
  /** ChatWait: Ollie is replying, or a visitor is waiting for a person (seconds). */
  wait?: { ollie: true } | { since: number };
  sla?: { tone: Tone; label: string };
  tags?: { name: string; tone: Tone }[];
  /** PresenceStack: a teammate on the ticket right now. */
  viewer?: { initials: string; tone: Tone; replying: boolean };
}

// Newest activity first. Noah's chat arrives on step 1, so it renders on its own.
const noah: Row = {
  who: 'Noah Fischer', subject: 'Shared notebook won’t open on iPhone', preview: 'It just spins after the update. Other notebooks open fine.',
  time: 'now', number: 2481, status: 'open', priority: 'normal', ai: true, unread: true, chat: true, wait: { ollie: true },
  tags: [{ name: 'ios', tone: 'blue' }],
};
const rows: Row[] = [
  {
    who: 'Hugo Moreau', subject: 'Charged twice for my upgrade', preview: 'Is anyone there? I can see two charges of €96 on my card from this morning.',
    time: '1m', number: 2479, status: 'open', priority: 'high', ai: true, unread: true, chat: true, wait: { since: 192 },
    tags: [{ name: 'billing', tone: 'orange' }], viewer: { initials: 'MC', tone: 'teal', replying: false },
  },
  {
    who: 'Katrin Vogel', subject: 'Sync between iPad and Mac', preview: 'Seit dem letzten Update synchronisieren meine Notizen nicht mehr zwischen iPad und Mac.',
    time: '48m', number: 2476, status: 'open', priority: 'normal', ai: true, unread: true,
    sla: { tone: 'amber', label: '18m' }, tags: [{ name: 'sync', tone: 'teal' }],
  },
  {
    who: 'Elena Rossi', subject: 'Can’t export notebook to PDF', preview: 'When I export our “Client brief” notebook, the images are missing from the PDF.',
    time: '1h', number: 2472, status: 'open', priority: 'high', unread: true,
    sla: { tone: 'red', label: '25m over' }, tags: [{ name: 'export', tone: 'violet' }, { name: 'bug', tone: 'red' }],
  },
  {
    who: 'Paula Martins', subject: 'Keyboard shortcuts on Windows', preview: 'On Windows every shortcut uses Ctrl where the Mac uses Cmd, so Ctrl K opens search.',
    time: '2h', number: 2468, status: 'pending', priority: 'low', tags: [{ name: 'how-to', tone: 'gray' }],
  },
  {
    who: 'Tom Becker', subject: 'Invoice address for Germany', preview: 'We moved offices, so the next invoice needs our new address in Berlin.',
    time: '3h', number: 2463, status: 'onHold', priority: 'low', tags: [{ name: 'billing', tone: 'orange' }],
  },
];

const level = { low: 1, normal: 2, high: 3, urgent: 3 } as const;
const tone = { low: 'gray', normal: 'blue', high: 'orange', urgent: 'red' } as const;
const statusTone = { open: 'blue', pending: 'amber', onHold: 'violet' } as const;
const clock = (s: number) => `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s`;

// The opendesk "Module" mark on its 64 grid (brand/, ios Brand.swift ODLogoMark).
const mark = 'M11 4h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M47 4a13 13 0 1 1 0 26a13 13 0 1 1 0-26Z M11 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M41 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z';
---
<div class="pm-box" aria-hidden="true">
  <div class="pm-device">
    <i class="pm-key" style="left:-3px;top:172px;height:34px"></i>
    <i class="pm-key" style="left:-3px;top:238px;height:62px"></i>
    <i class="pm-key" style="left:-3px;top:314px;height:62px"></i>
    <i class="pm-key pm-key-r" style="right:-3px;top:264px;height:100px"></i>
    <i class="pm-key pm-key-r pm-key-flush" style="right:-1.5px;top:566px;height:52px"></i>
    <div class="pm-band">
      <div class="pm-bezel">
        <div class="pm-screen">
          <!-- Status bar and Dynamic Island (system) -->
          <div class="pm-status pm-sys">
            <span class="pm-clock">9:41</span>
            <span class="pm-sysicons">
              <svg width="18" height="12" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="7.5" width="3.2" height="4.5" rx="1" /><rect x="4.8" y="5.2" width="3.2" height="6.8" rx="1" /><rect x="9.6" y="2.7" width="3.2" height="9.3" rx="1" /><rect x="14.4" y="0" width="3.2" height="12" rx="1" /></svg>
              <svg width="16" height="12" viewBox="0 0 16 12" fill="currentColor"><path d="M8 2.3c2.2 0 4.2.85 5.7 2.25.12.11.3.11.42-.01l1.1-1.11a.3.3 0 0 0 0-.43A10.1 10.1 0 0 0 8 .1 10.1 10.1 0 0 0 .78 3a.3.3 0 0 0 0 .43l1.1 1.11c.12.12.3.12.42.01A8.24 8.24 0 0 1 8 2.3Z" /><path d="M8 5.85c1.2 0 2.33.45 3.2 1.22.12.11.3.1.41-.01l1.1-1.11a.3.3 0 0 0 0-.44A6.85 6.85 0 0 0 8 3.66c-1.8 0-3.45.69-4.7 1.85a.3.3 0 0 0 0 .44l1.1 1.11c.11.11.3.12.41.01A4.74 4.74 0 0 1 8 5.85Z" /><path d="M10.25 8.7a.3.3 0 0 0-.01-.44A3.33 3.33 0 0 0 8 7.4c-.85 0-1.64.32-2.24.86a.3.3 0 0 0-.01.44l2.04 2.06c.12.12.3.12.42 0l2.04-2.06Z" /></svg>
              <svg width="27.5" height="13" viewBox="0 0 27.5 13"><rect x="0.5" y="0.5" width="24" height="12" rx="3.8" fill="none" stroke="currentColor" stroke-opacity="0.38" /><rect x="2" y="2" width="21" height="9" rx="2.4" fill="currentColor" /><path d="M26 4.4v4.2c.85-.3 1.4-1.15 1.4-2.1s-.55-1.8-1.4-2.1Z" fill="currentColor" fill-opacity="0.42" /></svg>
            </span>
          </div>
          <div class="pm-island"><i></i></div>

          <!-- GlassHeaderBar: menu, title and subtitle, search, filter -->
          <div class="pm-header">
            <span class="pm-glass pm-circle">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"><path d="M2 3.6h14M2 9h14M2 14.4h14" /></svg>
            </span>
            <div class="pm-titles">
              <div class="pm-title">Unassigned</div>
              <div class="pm-subtitle">
                <span data-step="0" data-until="1" data-wait="0">17 tickets · 5 awaiting reply</span><span class="s-swap" data-step="1" data-wait="1400">18 tickets · 6 awaiting reply</span>
              </div>
            </div>
            <span class="pm-glass pm-circle">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"><circle cx="7.6" cy="7.6" r="5.6" /><path d="m11.8 11.8 4.4 4.4" /></svg>
            </span>
            <span class="pm-glass pm-circle">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"><path d="M1.8 3.6h14.4M4.6 9h8.8M7.3 14.4h3.4" /></svg>
            </span>
          </div>

          <!-- The list: a white panel with rounded top corners on the grey chrome -->
          <div class="pm-list">
            <div class="pm-waiting">
              <span class="pm-ping" style="--pm-dot:var(--pm-red);--pm-size:7px"><i></i></span>
              <span class="pm-waiting-text">1 customer waiting in live chat</span>
              <span class="pm-waiting-act">Reply now</span>
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1.5 6h9M6.6 2l4 4-4 4" /></svg>
            </div>

            {[noah, ...rows].map((r, k) => {
              const urgent = !!r.wait && 'since' in r.wait;
              const row = (
                <div class={`pm-row ${urgent ? 'pm-urgent' : ''}`}>
                  <div class="pm-col">
                    <svg width="15" height="15" viewBox="0 0 16 16" style={`color:var(--pm-${statusTone[r.status]})`}>
                      {r.status === 'open' && <><circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="8" cy="8" r="2.25" fill="currentColor" /></>}
                      {r.status === 'pending' && <><circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 4.25a3.75 3.75 0 0 1 0 7.5Z" fill="currentColor" /></>}
                      {r.status === 'onHold' && <><circle cx="8" cy="8" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2.4 1.9" /><path d="M6.6 6v4M9.4 6v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></>}
                    </svg>
                    <span class="pm-prio">
                      <svg width="15" height="15" viewBox="0 0 16 16">
                        {[0, 1, 2].map((i) => (
                          <rect x={2.25 + i * 4.25} y={10 - i * 3.5} width="3" height={4 + i * 3.5} rx="0.9" style={`fill:${i < level[r.priority] ? `var(--pm-${tone[r.priority]})` : 'var(--pm-line-strong)'}`} />
                        ))}
                      </svg>
                      {r.ai && <Ollie size={9} eyes={false} class="pm-prio-ollie" />}
                    </span>
                  </div>
                  <div class="pm-main">
                    <div class="pm-top">
                      <span class={`pm-name ${r.unread ? 'pm-unread' : ''}`}>{r.who}</span>
                      {r.chat && (
                        <span class={`pm-chat ${urgent ? 'pm-chat-urgent' : ''}`}>
                          <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5C6.2 2.5 1.8 6.3 1.8 11c0 2.7 1.4 5 3.7 6.6-.3 1.6-1.2 3-2.5 3.9 2.3.2 4.4-.6 6-2 1 .3 2 .4 3 .4 5.8 0 10.2-3.8 10.2-8.9S17.8 2.5 12 2.5Z" /></svg>
                          Live chat
                        </span>
                      )}
                      {r.viewer && (
                        <span class="pm-viewer" style={`--pm-ring:var(--pm-${r.viewer.replying ? 'amber' : 'green'});--pm-av:var(--pm-${r.viewer.tone})`}><i>{r.viewer.initials}</i></span>
                      )}
                      <span class="pm-spacer"></span>
                      <span class="pm-time">{r.time}</span>
                    </div>
                    <div class={`pm-subject ${r.unread ? 'pm-unread' : ''}`}>{r.subject}</div>
                    <div class="pm-preview">{r.preview}</div>
                    <div class="pm-meta">
                      <span class="pm-number">#{r.number}</span>
                      {r.wait && ('ollie' in r.wait ? (
                        <span class="pm-wait pm-wait-ollie"><span class="pm-ping" style="--pm-dot:var(--pm-violet)"><i></i></span>Ollie is replying</span>
                      ) : (
                        <span class="pm-wait pm-wait-urgent"><span class="pm-ping" style="--pm-dot:#fff"><i></i></span><span data-pm-since={r.wait.since}>{clock(r.wait.since)}</span></span>
                      ))}
                      {r.sla && (
                        <span class="pm-sla" style={`--pm-t:var(--pm-${r.sla.tone})`}><i></i>{r.sla.label}</span>
                      )}
                      {r.tags?.slice(0, 2).map((t) => (
                        <span class="pm-label"><i style={`background:var(--pm-${t.tone})`}></i>{t.name}</span>
                      ))}
                    </div>
                  </div>
                </div>
              );
              return k === 0 ? (
                <div class="pm-arrive" data-step="1" data-wait="1400"><div>{row}</div></div>
              ) : row;
            })}
          </div>

          <!-- ODTabBar: a glass capsule of three icons and Ollie's round button -->
          <div class="pm-tabbar">
            <div class="pm-glass pm-tabs">
              <span class="pm-tab pm-tab-on">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd"><path d="M6.4 3.5h11.2c1.5 0 2.4.6 3 2l2.1 5.4c.2.5.3 1 .3 1.6v4.6c0 2.2-1.2 3.4-3.5 3.4H4.5C2.2 20.5 1 19.3 1 17.1v-4.6c0-.6.1-1.1.3-1.6l2.1-5.4c.6-1.4 1.5-2 3-2Zm-.2 2.2c-.5 0-.8.2-1 .7L3.3 11.3h5.1c.6 0 .9.4.9 1 0 1.4 1.1 2.6 2.7 2.6s2.7-1.2 2.7-2.6c0-.6.3-1 .9-1h5.1l-1.9-4.9c-.2-.5-.5-.7-1-.7H6.2Z" /></svg>
              </span>
              <span class="pm-tab">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linejoin="round"><path d="M12 3.2c-3.4 0-5.8 2.6-5.8 6v3.9l-1.6 2.6c-.4.7 0 1.4.8 1.4h13.2c.8 0 1.2-.7.8-1.4l-1.6-2.6V9.2c0-3.4-2.4-6-5.8-6Z" /><path d="M9.6 19.4a2.5 2.5 0 0 0 4.8 0" stroke-linecap="round" /></svg>
                <span class="pm-badge"><span data-step="0" data-until="1" data-wait="0">2</span><span class="s-swap" data-step="1" data-wait="1400">3</span></span>
              </span>
              <span class="pm-tab">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55"><circle cx="12" cy="12" r="9.6" /><circle cx="12" cy="9.6" r="3.4" /><path d="M5.6 18.9c1.4-2.3 3.7-3.6 6.4-3.6s5 1.3 6.4 3.6" stroke-linecap="round" /></svg>
              </span>
            </div>
            <span class="pm-glass pm-ollie"><Ollie size={28} /></span>
          </div>
          <i class="pm-home"></i>

          <!-- The push: an iOS 26 notification on Liquid Glass -->
          <div class="pm-push pm-sys s-push" data-step="1" data-wait="1400">
            <span class="pm-push-icon"><svg viewBox="0 0 64 64" width="21.3" height="21.3" fill="#fff"><path d={mark} /></svg></span>
            <span class="pm-push-text">
              <span class="pm-push-top"><b>New chat from Noah</b><span>now</span></span>
              <span class="pm-push-body">Shared notebook won’t open on iPhone</span>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // WaitPill: the visitor's wait ticks every second, as TimelineView does in the app.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clocks = [...document.querySelectorAll<HTMLElement>('[data-pm-since]')];
  if (!still && clocks.length) {
    const start = Date.now();
    setInterval(() => {
      for (const el of clocks) {
        const s = Number(el.dataset.pmSince) + Math.floor((Date.now() - start) / 1000);
        el.textContent = `${Math.floor(s / 60)}m ${String(s % 60).padStart(2, '0')}s`;
      }
    }, 1000);
  }
</script>

<style is:global>
  /* The device at its own size: 393 x 852 pt screen in a 21 pt frame, 435 x 894,
     scaled to the 292 px box. */
  .pm-box { position: absolute; inset: 0; }
  .pm-device {
    position: absolute; left: 0; top: 0; width: 435px; height: 894px;
    transform: scale(0.671264); transform-origin: 0 0;
  }
  .pm-key {
    position: absolute; width: 4.5px; border-radius: 2px;
    background: linear-gradient(90deg, #2a2a2d, #6b6b70 45%, #3a3a3e);
  }
  .pm-key-r { background: linear-gradient(90deg, #3a3a3e, #6b6b70 55%, #2a2a2d); }
  .pm-key-flush { width: 3px; opacity: 0.8; }
  .pm-band {
    position: absolute; inset: 0; border-radius: 76px; padding: 3px;
    background: linear-gradient(150deg, #77777c 0%, #3b3b3f 14%, #232326 40%, #2e2e31 62%, #5d5d62 88%, #8a8a8f 100%);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.55), 0 70px 120px -40px rgb(10 30 80 / 0.6), 0 30px 60px -30px rgb(0 0 0 / 0.45);
  }
  .pm-bezel {
    position: relative; height: 100%; border-radius: 73px; padding: 18px;
    background: #050506;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.07), inset 0 0 2px 1.5px #000;
  }

  /* Theme.swift */
  .pm-screen {
    --pm-chrome: #f5f5f5; --pm-surface: #ffffff; --pm-fg: #0a0a0a; --pm-fg2: #4a4a4a; --pm-fg3: #737373; --pm-fg4: #a3a3a3;
    --pm-line: #e4e4e4; --pm-line-soft: #f0f0f0; --pm-line-strong: #d6d6d6; --pm-glass: rgb(255 255 255 / 0.55);
    --pm-gray: #737373; --pm-red: #e03131; --pm-orange: #e8590c; --pm-amber: #d48806; --pm-green: #12a150;
    --pm-teal: #0c9488; --pm-blue: #2b6cf0; --pm-violet: #7048e8;
    --pm-sys-fg: #000; --pm-sys-2: rgb(60 60 67 / 0.6);
    position: relative; width: 393px; height: 852px; overflow: hidden; border-radius: 55px;
    background: var(--pm-chrome); color: var(--pm-fg);
    font-family: 'Geist Variable', 'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    line-height: 1.3; text-align: left; letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
  }
  .dark .pm-screen {
    --pm-chrome: #141416; --pm-surface: #1b1c1f; --pm-fg: #f7f7f7; --pm-fg2: #c4c4c4; --pm-fg3: #8f8f8f; --pm-fg4: #5f5f5f;
    --pm-line: #262626; --pm-line-soft: #1c1c1c; --pm-line-strong: #353535; --pm-glass: rgb(25 25 25 / 0.55);
    --pm-gray: #a3a3a3; --pm-red: #ff6b6b; --pm-orange: #ff8a4c; --pm-amber: #f5b53d; --pm-green: #3dd68c;
    --pm-teal: #2dd4bf; --pm-blue: #6b9bff; --pm-violet: #9d85ff;
    --pm-sys-fg: #fff; --pm-sys-2: rgb(235 235 245 / 0.6);
  }
  .pm-sys { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'SF Pro Display', system-ui, sans-serif; }
  .pm-screen svg { display: block; flex-shrink: 0; }

  /* Status bar */
  .pm-status { position: absolute; inset: 0 0 auto; height: 59px; color: var(--pm-sys-fg); }
  .pm-clock { position: absolute; left: 0; width: 134px; top: 18px; text-align: center; font-size: 17px; font-weight: 600; line-height: 22px; letter-spacing: -0.2px; padding-left: 10px; }
  .pm-sysicons { position: absolute; right: 0; width: 134px; top: 23px; display: flex; align-items: center; justify-content: center; gap: 6px; padding-right: 10px; }
  .pm-island { position: absolute; left: 133.5px; top: 11px; width: 126px; height: 37px; border-radius: 18.5px; background: #000; z-index: 6; }
  .pm-island i { position: absolute; right: 23px; top: 12.5px; width: 12px; height: 12px; border-radius: 50%; background: radial-gradient(circle at 40% 38%, #263247 0 18%, #0b0f18 46%, #050506 70%); }

  /* GlassHeaderBar: padding 16 / 6 / 8, spacing 10, 44 pt glass circles */
  .pm-header { position: absolute; left: 0; right: 0; top: 59px; display: flex; align-items: center; gap: 10px; padding: 6px 16px 8px; }
  .pm-glass {
    background: var(--pm-glass);
    -webkit-backdrop-filter: blur(12px) saturate(1.7); backdrop-filter: blur(12px) saturate(1.7);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.07), 0 8px 20px -10px rgb(0 0 0 / 0.22), inset 0 1px 1px rgb(255 255 255 / 0.95), inset 0 -1px 1px rgb(255 255 255 / 0.5), inset 0 0 0 1px rgb(255 255 255 / 0.55);
  }
  .dark .pm-glass {
    box-shadow: 0 0 0 0.5px rgb(255 255 255 / 0.1), 0 8px 20px -10px rgb(0 0 0 / 0.7), inset 0 1px 1px rgb(255 255 255 / 0.2), inset 0 -1px 1px rgb(255 255 255 / 0.05), inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }
  .pm-circle { display: flex; width: 44px; height: 44px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 50%; color: var(--pm-fg); }
  .pm-titles { flex: 1; min-width: 0; padding-left: 2px; display: flex; flex-direction: column; gap: 1px; }
  .pm-title { font-size: 19px; font-weight: 600; letter-spacing: -0.4px; white-space: nowrap; }
  .pm-subtitle { font-size: 13px; color: var(--pm-fg3); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pm-subtitle > span { display: inline-block; }

  /* The list: Theme.surface, top corners Radius.card (14) */
  .pm-list { position: absolute; left: 0; right: 0; top: 117px; bottom: 0; overflow: hidden; background: var(--pm-surface); border-radius: 14px 14px 0 0; }

  /* WaitingBanner: insets 10 / 12 / 4, 40 high, Radius.control (10) */
  .pm-waiting {
    display: flex; align-items: center; gap: 10px; height: 40px; margin: 10px 12px 4px; padding: 0 12px;
    border-radius: 10px; color: color-mix(in srgb, var(--pm-red) 82%, var(--pm-fg));
    background: color-mix(in srgb, var(--pm-red) 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pm-red) 18%, transparent);
  }
