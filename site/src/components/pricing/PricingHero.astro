---
/**
 * The top of /pricing: the three plans standing in a painted valley, under a
 * left-aligned headline.
 */
import PlanCards from '../PlanCards.astro';
import Backdrop from '../home/Backdrop.astro';
---
<section class="px-2 pt-2 md:px-3 md:pt-3">
  <div class="relative isolate overflow-hidden rounded-[22px] md:rounded-[28px]">
    <Backdrop name="green-valley" priority sizes="100vw" class="absolute inset-0 -z-10 h-full w-full" style="object-position:50% 25%" />
    <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(14_40_110/0.62)_0%,rgb(14_40_110/0.3)_32%,transparent_55%)]"></div>

    <div class="container-page pt-16 text-white md:pt-24">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
        <div>
          <div class="font-mono text-[11.5px] font-medium uppercase tracking-[0.08em] text-white/75">Pricing</div>
          <h1 class="mt-5 text-[44px] font-semibold leading-[0.98] tracking-[-0.05em] [text-shadow:0_2px_30px_rgb(10_30_80/0.35)] sm:text-[64px] lg:text-[80px]">Free to start.<br />One price to grow.</h1>
        </div>
        <p class="max-w-[460px] text-[17px] leading-[1.55] text-white/90 [text-shadow:0_1px_18px_rgb(10_30_80/0.5)] md:text-[18px] lg:pb-2">Every plan has every feature, Ollie included. Plans differ only in how many people and mailboxes you have, and who runs the servers.</p>
      </div>
    </div>

    <div class="container-page mt-12 pb-3 md:mt-16 md:pb-12 lg:mt-20">
      <PlanCards glass />
      <p class="mt-5 text-center font-mono text-[11px] uppercase tracking-[0.08em] text-white [text-shadow:0_1px_2px_rgb(10_30_80/0.55),0_1px_12px_rgb(10_30_80/0.75)]">Prices in US dollars, excluding taxes · Paid plans are for businesses</p>
    </div>
  </div>
</section>
