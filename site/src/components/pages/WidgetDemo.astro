---
/**
 * The chat widget on a sample shop's page. The widget
 * is the real one on its demo backend: it answers from sample articles in the
 * browser and never reaches a person.
 */
import Backdrop from '../home/Backdrop.astro';
import LiveWidget from '../home/LiveWidget.astro';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<div class={`relative h-[640px] overflow-hidden rounded-[22px] ring-1 ring-line ${className}`}>
  <Backdrop name="cumulus-fields" sizes="(min-width: 1440px) 1360px, 100vw" class="absolute inset-0 h-full w-full" />

  <!-- The sample shop's page, behind the widget. -->
  <div class="absolute left-8 top-8 hidden w-[min(560px,calc(100%-480px))] rounded-[16px] bg-white/80 p-7 shadow-[0_30px_60px_-30px_rgb(10_30_80/0.4)] ring-1 ring-black/5 backdrop-blur-md lg:block dark:bg-black/55 dark:ring-white/10" aria-hidden="true">
    <div class="flex items-center gap-2">
      <svg viewBox="0 0 64 64" class="size-7 rounded-[7px]" aria-hidden="true"><rect width="64" height="64" fill="#f5efe3" /><path d="M10 22h44M10 32h44M10 42h44M10 52h44" stroke="#9db8dc" stroke-width="2.5" /><path d="M21 0v64" stroke="#d6453d" stroke-width="3.5" /></svg>
      <span class="text-[13px] font-semibold text-fg">Margin</span>
      <span class="ml-auto flex gap-4 text-[11.5px] text-muted"><span>Notebooks</span><span>Journal</span><span>Help</span><span class="text-fg">Cart (2)</span></span>
    </div>
    <div class="mt-12 text-[34px] font-semibold leading-[1.05] tracking-[-0.035em] text-fg">Notebooks for people<br />who think on paper.</div>
    <div class="mt-5 space-y-2"><div class="h-2 w-[82%] rounded-full bg-black/10 dark:bg-white/15"></div><div class="h-2 w-[58%] rounded-full bg-black/10 dark:bg-white/15"></div></div>
    <div class="mt-8 grid grid-cols-3 gap-3">
      {['#d9c7a7', '#9fb7a8', '#c9a9a0'].map((c) => (
        <div>
          <div class="aspect-[4/5] rounded-[10px] ring-1 ring-black/5" style={`background:${c}`}></div>
          <div class="mt-2 h-1.5 w-[70%] rounded-full bg-black/12 dark:bg-white/20"></div>
          <div class="mt-1.5 h-1.5 w-[40%] rounded-full bg-black/8 dark:bg-white/12"></div>
        </div>
      ))}
    </div>
  </div>

  <LiveWidget scene="chat" />
</div>
