---
import { ICONS, BRAND_PATHS, type BrandName, type IconName } from '../lib/icons';

interface Props {
  name: IconName | BrandName;
  size?: number;
  stroke?: number;
  class?: string;
}
const { name, size = 18, stroke = 1.75, class: className = '' } = Astro.props;
---
{name in BRAND_PATHS ? (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" class={className} aria-hidden="true"><path d={BRAND_PATHS[name as BrandName]} /></svg>
) : (
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width={stroke}
    stroke-linecap="round"
    stroke-linejoin="round"
    class={className}
    aria-hidden="true"
    set:html={ICONS[name as IconName]}
  />
)}
