---
/**
 * The repository as GitHub shows it: the real top level with what each part is,
 * the README, and the latest commits on main turning over. Beside it, through a
 * pane of pines, the commit graph keeps growing and CI ticks off its checks.
 * Loops while on screen.
 */
import Stage from '../Stage.astro';
import Icon from '../Icon.astro';
import Backdrop from '../home/Backdrop.astro';

const files: [string, boolean, string][] = [
  ['.github', true, 'CI and release workflows'],
  ['brand', true, 'Logo, icons and tokens'],
  ['cmd/opendesk', true, 'The one Go binary'],
  ['contracts', true, 'API, events, realtime and tokens'],
  ['deploy', true, 'Docker, Caddy, Terraform, Email Worker'],
  ['desktop', true, 'Electron app for Mac, Windows and Linux'],
  ['docs', true, 'docs.opendesk.sh'],
  ['internal', true, 'API and workers, by area'],
  ['ios', true, 'Native SwiftUI iPhone app'],
  ['migrations', true, 'SQL, embedded and applied at boot'],
  ['realtime', true, 'Elixir and Phoenix gateway'],
  ['site', true, 'opendesk.sh'],
  ['web', true, 'Web app, help center and widget'],
  ['AGENTS.md', false, 'How the parts fit together'],
  ['Makefile', false, 'make dev-db, api, realtime, web'],
];

// The latest commits on main, as they are.
const commits: [string, string][] = [
  ['d0990c9', 'feat: add the Ollie AI agent for chat and email with metered credits'],
  ['3d1b002', 'feat: redesign Ollie’s ticket panel and let Ollie work in connected tools over MCP'],
  ['ca127eb', 'fix: make the rate limiter refill test independent of machine speed'],
  ['b5fc8d2', 'feat: let a manual CI run check every part of the repository'],
];

const checks = ['go build, vet and test', 'govulncheck', 'pnpm audit', 'mix deps.audit', 'Trivy image scan'];

// A commit graph: a year of weeks, the levels from a fixed sequence so every build draws the same one.
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const weeks = Array.from({ length: 40 }, () => Array.from({ length: 7 }, () => {
  const r = rnd();
  return r < 0.22 ? 0 : r < 0.5 ? 1 : r < 0.75 ? 2 : r < 0.92 ? 3 : 4;
}));
const level = ['bg-[color-mix(in_oklab,var(--fg)_7%,transparent)]', 'bg-[#9be9a8]', 'bg-[#40c463]', 'bg-[#30a14e]', 'bg-[#216e39]'];
---
<Stage w={1320} h={800} tone="none" mobileW={760} mobileX={0} label="The opendesk repository on GitHub: its folders, the README, the latest commits on main, a growing commit graph and the checks CI runs on a pull request.">
  <div data-seq data-hold="2600" class="absolute inset-0">
    <!-- Repository window -->
    <div class="absolute left-0 top-0 flex h-[800px] w-[948px] flex-col overflow-hidden rounded-[14px] bg-bg text-left text-fg shadow-[0_40px_90px_-50px_rgb(10_20_40/0.45)] ring-1 ring-line">
      <div class="flex h-12 shrink-0 items-center gap-2.5 border-b border-line bg-surface-2 px-5 text-[13px]">
        <Icon name="github" size={16} />
        <span class="text-muted">useopendesk</span><span class="text-subtle">/</span><span class="font-semibold">opendesk</span>
        <span class="rounded-full px-2 py-px text-[10.5px] text-muted ring-1 ring-line">Public</span>
        <span class="ml-auto flex items-center gap-2 text-[12px]">
          {['eye:Watch', 'gitBranch:Fork', 'star:Star'].map((b) => { const [i, l] = b.split(':'); return <span class="flex h-7 items-center gap-1.5 rounded-md bg-bg px-2.5 ring-1 ring-line"><Icon name={i as 'eye'} size={12} class="text-muted" />{l}</span>; })}
        </span>
      </div>
      <div class="flex h-11 shrink-0 items-end gap-5 border-b border-line bg-surface-2 px-5 text-[12.5px] text-muted">
        <span class="flex h-full items-center gap-1.5 border-b-2 border-[#fd8c73] font-medium text-fg"><Icon name="code" size={13} />Code</span>
        <span class="flex h-full items-center gap-1.5"><Icon name="circleDot" size={13} />Issues</span>
        <span class="flex h-full items-center gap-1.5"><Icon name="gitPullRequest" size={13} />Pull requests</span>
        <span class="flex h-full items-center gap-1.5"><Icon name="zap" size={13} />Actions</span>
        <span class="flex h-full items-center gap-1.5"><Icon name="shield" size={13} />Security</span>
      </div>

      <div class="flex min-h-0 flex-1 gap-6 px-6 pt-5">
        <div class="flex min-w-0 flex-1 flex-col">
          <div class="flex items-center gap-2 text-[12px]">
            <span class="flex h-8 items-center gap-1.5 rounded-md bg-surface-2 px-2.5 font-mono ring-1 ring-line"><Icon name="gitBranch" size={12} />main<Icon name="chevronDown" size={11} class="text-subtle" /></span>
            <span class="ml-auto flex h-8 w-[180px] items-center gap-2 rounded-md px-2.5 text-subtle ring-1 ring-line"><Icon name="search" size={12} />Go to file</span>
            <span class="flex h-8 items-center gap-1.5 rounded-md bg-[#1f883d] px-3 font-medium text-white"><Icon name="code" size={12} />Code<Icon name="chevronDown" size={11} /></span>
          </div>

          <div class="mt-4 overflow-hidden rounded-[10px] ring-1 ring-line">
            <!-- The latest commit, turning over -->
            <div class="relative flex h-11 items-center gap-2.5 bg-surface-2 px-4 text-[12px]">
              <svg viewBox="0 0 64 64" class="size-5 shrink-0 rounded-full bg-fg p-1 text-bg" fill="currentColor" aria-hidden="true"><path d="M11 4h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M47 4a13 13 0 1 1 0 26a13 13 0 1 1 0-26Z M11 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M41 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z"/></svg>
              <span class="relative min-w-0 flex-1">
                {commits.map(([h, m], i) => (
                  <span class={`flex min-w-0 items-center gap-3 ${i ? 's-swap' : ''}`} data-step={i * 3} data-wait={i === 0 ? 0 : 2600} data-until={i < commits.length - 1 ? (i + 1) * 3 : undefined}>
                    <span class="truncate text-body">{m}</span>
                    <span class="ml-auto shrink-0 font-mono text-[11px] text-muted">{h}</span>
                  </span>
                ))}
              </span>
              <span class="flex shrink-0 items-center gap-1 font-mono text-[11px] text-muted"><Icon name="clock" size={11} />History</span>
            </div>
            {files.map(([name, dir, what]) => (
              <div class="flex h-[29px] items-center gap-3 border-t border-line px-4 text-[12.5px]">
                <Icon name={dir ? 'folder' : 'file'} size={14} class={`shrink-0 ${dir ? 'text-[#54aeff]' : 'text-subtle'}`} />
                <span class="w-[150px] shrink-0 truncate text-fg">{name}</span>
                <span class="truncate text-muted">{what}</span>
              </div>
            ))}
          </div>

          <!-- README -->
          <div class="mt-4 flex-1 overflow-hidden rounded-t-[10px] ring-1 ring-line">
            <div class="flex h-10 items-center gap-4 border-b border-line px-4 text-[12px]">
              <span class="flex h-full items-center gap-1.5 border-b-2 border-[#fd8c73] font-medium text-fg"><Icon name="book" size={12} />README</span>
              <span class="flex items-center gap-1.5 text-muted"><Icon name="scale" size={12} />Apache-2.0 license</span>
              <span class="flex items-center gap-1.5 text-muted"><Icon name="shield" size={12} />Security</span>
            </div>
            <div class="flex flex-col items-center px-6 pt-6 text-center">
              <span class="flex items-center gap-2"><svg viewBox="0 0 64 64" class="size-7" fill="currentColor" aria-hidden="true"><path d="M11 4h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M47 4a13 13 0 1 1 0 26a13 13 0 1 1 0-26Z M11 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z M41 34h12a7 7 0 0 1 7 7v12a7 7 0 0 1-7 7h-12a7 7 0 0 1-7-7v-12a7 7 0 0 1 7-7Z"/></svg><span class="text-[24px] font-semibold tracking-[-0.04em]">opendesk</span></span>
              <p class="mt-3 text-[13px] text-body">The open-source helpdesk.</p>
              <p class="mt-1 text-[13px] text-[#0969da] dark:text-[#4493f8]">opendesk.sh</p>
              <div class="mt-4 h-px w-full bg-line"></div>
              <p class="mt-4 text-[13px] text-body">Self-host it, own your data, run support in the open.</p>
            </div>
          </div>
        </div>

        <!-- About -->
        <aside class="w-[220px] shrink-0 text-[12.5px]">
          <div class="text-[14px] font-semibold">About</div>
          <p class="mt-2 leading-relaxed text-body">The open-source helpdesk: shared inboxes, live chat, a help center and Ollie.</p>
          <p class="mt-2 flex items-center gap-1.5 font-medium text-[#0969da] dark:text-[#4493f8]"><Icon name="globe" size={12} />opendesk.sh</p>
          <ul class="mt-4 space-y-2 text-muted">
            <li class="flex items-center gap-2"><Icon name="book" size={13} />Readme</li>
            <li class="flex items-center gap-2"><Icon name="scale" size={13} />Apache-2.0 license</li>
            <li class="flex items-center gap-2"><Icon name="shield" size={13} />Security policy</li>
          </ul>
          <div class="mt-5 border-t border-line pt-4 text-[14px] font-semibold">Packages</div>
          <ul class="mt-2 space-y-1.5 font-mono text-[11px] text-muted">
            <li>ghcr.io/useopendesk/opendesk</li>
            <li>ghcr.io/useopendesk/realtime</li>
          </ul>
          <div class="mt-5 border-t border-line pt-4 text-[14px] font-semibold">Built with</div>
          <div class="mt-2.5 flex flex-wrap gap-1.5">
            {[['Go', '#00add8'], ['TypeScript', '#3178c6'], ['Elixir', '#6e4a7e'], ['Swift', '#f05138'], ['SQL', '#e38c00']].map(([l, c]) => (
              <span class="flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[11.5px] text-body ring-1 ring-line"><i class="size-2 rounded-full" style={`background:${c}`}></i>{l}</span>
            ))}
          </div>
        </aside>
      </div>
    </div>

    <!-- Through the pines -->
    <div class="absolute left-[972px] top-[40px] h-[760px] w-[348px] overflow-hidden rounded-[14px] ring-1 ring-line">
      <Backdrop name="pines" sizes="(min-width: 1024px) 26vw, 50vw" class="absolute inset-0 h-full w-full" style="object-position:72% 50%" />
      <div class="absolute inset-x-4 top-4 rounded-[12px] bg-white/80 p-4 text-left text-[#0a0a0a] shadow-[0_20px_40px_-20px_rgb(10_30_80/0.5)] ring-1 ring-black/5 backdrop-blur-md dark:bg-black/60 dark:text-white dark:ring-white/10">
        <div class="flex items-center gap-2 text-[12.5px] font-semibold"><Icon name="gitMerge" size={13} />Commits to main<span class="ml-auto flex items-center gap-1.5 font-mono text-[10px] font-normal opacity-60"><span class="size-1.5 rounded-full bg-[#40c463] od-live"></span>live</span></div>
        <div class="og-graph relative mt-3 overflow-hidden">
          <div class="og-track flex w-max gap-[3px]">
            {[...weeks, ...weeks].map((w) => (
              <div class="flex flex-col gap-[3px]">{w.map((l) => <i class={`block size-[10px] rounded-[2px] ${level[l]}`}></i>)}</div>
            ))}
          </div>
        </div>
        <div class="mt-2 flex items-center justify-end gap-1 font-mono text-[9.5px] opacity-60">Less{level.map((c) => <i class={`block size-[9px] rounded-[2px] ${c}`}></i>)}More</div>
      </div>

      <div class="absolute inset-x-4 bottom-4 rounded-[12px] bg-bg text-left shadow-[0_20px_40px_-20px_rgb(10_30_80/0.5)] ring-1 ring-line">
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <Icon name="gitPullRequest" size={14} class="text-[#1f883d]" />
          <span class="text-[12.5px] font-semibold text-fg">Pull request checks</span>
        </div>
        <ul class="px-2 py-2 text-[12px]">
          {checks.map((c, i) => (
            <li class="flex h-[30px] items-center gap-2.5 rounded-md px-2">
              <span class="relative flex size-4 items-center justify-center">
                <span data-step="0" data-wait="0" data-until={i * 2 + 2} class="og-wait size-3.5 rounded-full ring-[1.5px] ring-inset ring-[#bf8700]"></span>
                <span data-step={i * 2 + 2} class="s-swap flex size-4 items-center justify-center rounded-full bg-[#1f883d] text-white"><Icon name="check" size={10} stroke={3} /></span>
              </span>
              <span class="text-fg">{c}</span>
            </li>
          ))}
        </ul>
        <div class="flex items-center gap-2 rounded-b-[12px] border-t border-line bg-surface-2 px-4 py-2.5 text-[11.5px] text-muted">
          <span data-step="0" data-wait="0" data-until="10">Running</span><span data-step="10" class="s-swap font-medium text-[#1f883d]">All checks have passed</span>
        </div>
      </div>
    </div>
  </div>
</Stage>

<style>
  .og-graph { mask-image: linear-gradient(90deg, transparent, #000 10%, #000 100%); }
  .og-track { animation: og-grow 48s linear infinite; }
  @keyframes og-grow { to { transform: translateX(calc(-50% - 1.5px)); } }
  .og-wait { animation: og-pulse 1.4s ease-in-out infinite; }
  @keyframes og-pulse { 50% { opacity: 0.35; } }
  @media (prefers-reduced-motion: reduce) { .og-track, .og-wait { animation: none; } }
</style>
