---
/**
 * Questions as a calm accordion: one answer open at a time, the height eases
 * open and shut, the plus folds into a minus, and the arrow keys move between
 * questions. Without JS every answer is shown.
 */
interface Props {
  items: { q: string; a: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---
<div class={`hfaq rounded-[18px] bg-bg ring-1 ring-line ${className}`} data-hfaq>
  {items.map((f, i) => (
    <div class={`hfaq-item ${i === 0 ? 'is-open' : ''}`}>
      <h3>
        <button type="button" id={`hfaq-q-${i}`} aria-controls={`hfaq-a-${i}`} aria-expanded={i === 0 ? 'true' : 'false'} class="hfaq-q group flex w-full items-center gap-5 px-5 py-5 text-left md:px-7">
          <span class="hfaq-n font-mono text-[11.5px] tabular-nums text-subtle">{String(i + 1).padStart(2, '0')}</span>
          <span class="flex-1 text-[16px] font-medium tracking-[-0.01em] text-fg">{f.q}</span>
          <span class="hfaq-icon relative flex size-8 shrink-0 items-center justify-center rounded-full text-muted ring-1 ring-line" aria-hidden="true">
            <i class="absolute h-[1.5px] w-3 rounded-full bg-current"></i>
            <i class="hfaq-v absolute h-3 w-[1.5px] rounded-full bg-current"></i>
          </span>
        </button>
      </h3>
      <div id={`hfaq-a-${i}`} role="region" aria-labelledby={`hfaq-q-${i}`} class="hfaq-a grid">
        <div class="overflow-hidden">
          <p class="hfaq-text max-w-[62ch] px-5 pb-6 pl-[3.85rem] text-[15px] leading-relaxed text-muted md:px-7 md:pl-[4.6rem]">{f.a}</p>
        </div>
      </div>
    </div>
  ))}
</div>

<style is:global>
  .hfaq-item + .hfaq-item { border-top: 1px solid var(--line); }
  .hfaq-item:first-child .hfaq-q { border-radius: 18px 18px 0 0; }
  .hfaq-item:last-child:not(.is-open) .hfaq-q { border-radius: 0 0 18px 18px; }
  .hfaq-q { transition: background-color 200ms ease; }
  .hfaq-q:hover { background: var(--surface-2); }
  .hfaq-q:focus-visible { outline-offset: -2px; }
  .hfaq-n { transition: color 250ms ease; }
  .hfaq-icon { transition: color 250ms ease, background-color 250ms ease, box-shadow 250ms ease, transform 450ms cubic-bezier(0.22, 1, 0.36, 1); }
  .hfaq-v { transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1); }
  .hfaq-q:hover .hfaq-icon { color: var(--fg); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .hfaq-item.is-open .hfaq-n { color: var(--fg); }
  .hfaq-item.is-open .hfaq-icon { color: var(--bg); background: var(--fg); box-shadow: none; transform: rotate(180deg); }
  .hfaq-item.is-open .hfaq-v { transform: scaleY(0); }

  /* Closed answers fold away once the script is running. */
  .js .hfaq-a { grid-template-rows: 0fr; transition: grid-template-rows 420ms cubic-bezier(0.22, 1, 0.36, 1); }
  .js .hfaq-item.is-open .hfaq-a { grid-template-rows: 1fr; }
  .js .hfaq-text { opacity: 0; transform: translateY(-4px); transition: opacity 260ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1); }
  .js .hfaq-item.is-open .hfaq-text { opacity: 1; transform: none; transition-delay: 80ms; }
  @media (prefers-reduced-motion: reduce) {
    .hfaq-a, .hfaq-text, .hfaq-icon, .hfaq-v { transition: none !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-hfaq]').forEach((root) => {
    const items = [...root.querySelectorAll<HTMLElement>('.hfaq-item')];
    const buttons = items.map((it) => it.querySelector<HTMLButtonElement>('.hfaq-q')!);
    const set = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('.hfaq-q')?.setAttribute('aria-expanded', String(open));
    };
    buttons.forEach((b, i) => {
      b.addEventListener('click', () => {
        const open = !items[i].classList.contains('is-open');
        items.forEach((it, k) => set(it, k === i && open));
      });
      b.addEventListener('keydown', (e) => {
        const to = { ArrowDown: i + 1, ArrowUp: i - 1, Home: 0, End: buttons.length - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        buttons[(to + buttons.length) % buttons.length].focus();
      });
    });
  });
</script>
