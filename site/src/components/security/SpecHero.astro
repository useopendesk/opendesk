---
/**
 * The top of /security: the first sheet of a written standard. A ruled page
 * with crop marks, the headline set left, and on the right a stack of control
 * cards that turns over continuously under a CASA Tier 1 / ASVS L1 seal. The
 * contents run along the foot of the sheet.
 */
import Icon from '../Icon.astro';
import { LINKS } from '../../lib/site';

const cards = [
  { n: '1.1', ch: 'V2', title: 'Passwords', body: 'Hashed with Argon2id, 12 to 128 characters, and checked against a list of breached passwords.', ref: 'auth.HashPassword' },
  { n: '2.1', ch: 'V3', title: 'Refresh tokens', body: 'Rotate on every use and are stored hashed. Access tokens live 15 minutes.', ref: 'crypto.HashToken' },
  { n: '4.2', ch: 'V6', title: 'Stored secrets', body: 'Mailbox passwords, OAuth tokens and webhook secrets are sealed with AES-GCM by the app.', ref: 'crypto.Box' },
  { n: '3.1', ch: 'V4', title: 'Workspace isolation', body: 'Every read and write is scoped to the caller’s workspace on the server.', ref: 'workspace_id = $1' },
];

const contents: [string, string, string, string][] = [
  ['0', 'Scope', '#scope', ''],
  ['1', 'Authentication', '#authentication', 'V2'],
  ['2', 'Sessions and tokens', '#sessions', 'V3'],
  ['3', 'Access control', '#access', 'V4'],
  ['4', 'Data protection', '#data', 'V5 · V6 · V9'],
  ['5', 'Accountability', '#accountability', 'V7 · V8 · V14'],
  ['A', 'Where the cloud runs', '#cloud', ''],
  ['B', 'Responsible disclosure', '#disclosure', ''],
];

const ring = 'CASA TIER 1 · OWASP ASVS 4.0.3 LEVEL 1 · APP DEFENSE ALLIANCE · ';
---
<section class="container-page pt-8 md:pt-12">
  <div class="sec-sheet relative rounded-[6px] bg-bg ring-1 ring-line">
    <span class="sec-crop sec-crop-tl" aria-hidden="true"></span>
    <span class="sec-crop sec-crop-tr" aria-hidden="true"></span>
    <span class="sec-crop sec-crop-bl" aria-hidden="true"></span>
    <span class="sec-crop sec-crop-br" aria-hidden="true"></span>

    <!-- Running head -->
    <div class="flex items-center gap-3 border-b border-line px-5 py-3 font-mono text-[11px] uppercase tracking-[0.08em] text-muted md:px-10">
      <span class="text-fg">opendesk</span><span class="text-faint">/</span><span>Security controls</span>
      <span class="ml-auto hidden sm:inline">Cloud and self-hosted, one code base</span>
    </div>

    <div class="grid gap-14 px-5 pb-12 pt-12 md:px-10 md:pb-16 md:pt-16 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:gap-10">
      <div class="relative">
        <div class="font-mono text-[12px] text-muted">The standard every change follows</div>
        <h1 class="mt-5 text-[52px] font-semibold leading-[0.96] tracking-[-0.05em] text-fg sm:text-[72px] lg:text-[96px]">Security<br />you can read.</h1>
        <p class="mt-7 max-w-[52ch] text-[17px] leading-[1.6] text-muted md:text-[18px]">opendesk handles your customers’ email, so security is a property of the code, not a page of promises. The code is open, and these are the rules every change follows.</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={LINKS.github} class="btn btn-lg btn-primary"><Icon name="github" size={15} />Read the code</a>
          <a href="#disclosure" class="btn btn-lg btn-ghost"><Icon name="shield" size={15} />Report a vulnerability</a>
        </div>
        <p class="mt-6 font-mono text-[11px] uppercase tracking-[0.08em] text-subtle">CASA Tier 1 · OWASP ASVS 4.0.3 Level 1</p>
      </div>

      <!-- The controls, turning over, under the seal -->
      <div class="relative min-h-[400px] sm:min-h-[430px]" aria-label="Some of the controls: passwords, refresh tokens, stored secrets and workspace isolation.">
        <div class="sec-stack absolute inset-x-0 bottom-6 mx-auto h-[236px] max-w-[420px] sm:bottom-10">
          {cards.map((c, i) => (
            <div class="sec-card absolute inset-x-0 bottom-0 overflow-hidden rounded-[12px] bg-raised text-left shadow-[var(--shadow-float)] ring-1 ring-line" aria-hidden={i > 0 ? 'true' : undefined}>
              <div class="flex items-center justify-between border-b border-line px-4 py-2.5 font-mono text-[11px] text-muted">
                <span>Clause <span class="text-fg">{c.n}</span></span><span>ASVS {c.ch}</span>
              </div>
              <div class="px-4 pb-4 pt-3.5">
                <div class="text-[16px] font-semibold tracking-[-0.02em] text-fg">{c.title}</div>
                <p class="mt-1 text-[13px] leading-relaxed text-muted">{c.body}</p>
              </div>
              <div class="flex items-center gap-2 border-t border-line px-4 py-2.5">
                <code class="truncate font-mono text-[11px] text-body">{c.ref}</code>
                <span class="pill t-green ml-auto shrink-0"><Icon name="check" size={11} stroke={2.5} />Enforced</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Seal -->
        <div class="sec-seal absolute left-0 top-0 size-[150px] sm:left-2 sm:size-[170px]" role="img" aria-label="CASA Tier 1, OWASP ASVS 4.0.3 Level 1">
          <div class="absolute inset-0 rounded-full bg-fg shadow-[var(--shadow-float)]"></div>
          <svg viewBox="0 0 170 170" class="sec-seal-ring absolute inset-0 size-full text-bg" aria-hidden="true">
            <defs><path id="sec-seal-path" d="M85 85 m-66 0 a66 66 0 1 1 132 0 a66 66 0 1 1 -132 0" /></defs>
            <text class="font-mono" font-size="9.6" letter-spacing="0.6" fill="currentColor"><textPath href="#sec-seal-path" textLength="412" lengthAdjust="spacing">{ring}</textPath></text>
          </svg>
          <div class="absolute inset-[26px] flex flex-col items-center justify-center rounded-full text-bg ring-1 ring-[color-mix(in_oklab,var(--bg)_35%,transparent)] sm:inset-[30px]">
            <Icon name="shieldCheck" size={18} />
            <div class="mt-1 text-[19px] font-semibold leading-none tracking-[-0.03em] sm:text-[22px]">CASA</div>
            <div class="mt-1 font-mono text-[10px] uppercase tracking-[0.12em] opacity-75">Tier 1</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contents -->
    <nav class="border-t border-line px-5 py-6 md:px-10 md:py-8" aria-label="Contents">
      <div class="font-mono text-[11px] uppercase tracking-[0.08em] text-muted">Contents</div>
      <ol class="mt-3 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {contents.map(([n, t, href, r]) => (
          <li class="border-t border-line">
            <a href={href} class="group flex items-baseline gap-3 py-3 text-[14px] text-body hover:text-fg">
              <span class="w-4 shrink-0 font-mono text-[12px] text-fg">{n}</span>
              <span class="truncate group-hover:underline group-hover:decoration-line-strong group-hover:underline-offset-4">{t}</span>
              <span class="sec-leader min-w-4 flex-1"></span>
              <span class="shrink-0 font-mono text-[11px] text-subtle">{r || '·'}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</section>

<style is:global>
  .sec-sheet {
    background-image: linear-gradient(color-mix(in oklab, var(--line) 55%, transparent) 1px, transparent 1px);
    background-size: 100% 32px;
    background-position: 0 -1px;
  }
  .sec-crop { position: absolute; width: 16px; height: 16px; border-color: var(--fg); pointer-events: none; }
  .sec-crop-tl { left: -9px; top: -9px; border-left-width: 1px; border-top-width: 1px; }
  .sec-crop-tr { right: -9px; top: -9px; border-right-width: 1px; border-top-width: 1px; }
  .sec-crop-bl { left: -9px; bottom: -9px; border-left-width: 1px; border-bottom-width: 1px; }
  .sec-crop-br { right: -9px; bottom: -9px; border-right-width: 1px; border-bottom-width: 1px; }
  .sec-leader { border-bottom: 1px dotted var(--line-strong); transform: translateY(-4px); }

  /* Four cards, four places: front, two peeking behind, one out of sight. */
  .sec-card { transform-origin: 50% 0; animation: sec-stack 16s ease-in-out infinite; }
  .sec-card:nth-child(1) { animation-delay: 0s; }
  .sec-card:nth-child(2) { animation-delay: -12s; }
  .sec-card:nth-child(3) { animation-delay: -8s; }
  .sec-card:nth-child(4) { animation-delay: -4s; }
  @keyframes sec-stack {
    0%, 21% { transform: translateY(0) scale(1); opacity: 1; z-index: 4; }
    25% { transform: translateY(46px) scale(1); opacity: 0; z-index: 4; }
    25.5%, 46% { transform: translateY(-66px) scale(0.85); opacity: 0; z-index: 1; }
    50%, 71% { transform: translateY(-44px) scale(0.9); opacity: 0.55; z-index: 2; }
    75%, 96% { transform: translateY(-22px) scale(0.95); opacity: 0.85; z-index: 3; }
    100% { transform: translateY(0) scale(1); opacity: 1; z-index: 4; }
  }
  .sec-seal { transform: rotate(-8deg); z-index: 5; }
  .sec-seal-ring { animation: sec-seal 48s linear infinite; }
  @keyframes sec-seal { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .sec-card, .sec-seal-ring { animation: none; }
    .sec-card:nth-child(1) { z-index: 4; }
    .sec-card:nth-child(2) { transform: translateY(-22px) scale(0.95); opacity: 0.85; z-index: 3; }
    .sec-card:nth-child(3) { transform: translateY(-44px) scale(0.9); opacity: 0.55; z-index: 2; }
    .sec-card:nth-child(4) { opacity: 0; }
  }
</style>
