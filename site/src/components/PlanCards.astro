---
/**
 * The three plans, on the home page and on /pricing. Each card carries a small
 * picture of what it buys: one seat on Free, a team of seats on Pro (viewers
 * free), the one command on Self-hosted. Pro, the plan most teams pick, stands
 * forward inside a slowly turning ring of the brand's blues and violet.
 */
import Icon from './Icon.astro';
import CopyCommand from './CopyCommand.astro';
import { PLANS } from '../lib/pricing';

interface Props {
  /** Over a painting: the quieter cards turn to frosted glass. */
  glass?: boolean;
  class?: string;
}
const { glass = false, class: className = '' } = Astro.props;

const seats = [
  ['LH', '#1e3a5f', '#fff'],
  ['MC', '#e9d5c4', '#6b4a2f'],
  ['TB', '#d7e6d2', '#2f5a28'],
  ['AB', '#dbe4f5', '#2a4a80'],
  ['KV', '#f3dbe3', '#7a2a48'],
] as const;
---
<div class={`grid items-stretch gap-3 lg:grid-cols-[1fr_1.12fr_1fr] lg:gap-4 ${className}`}>
  {PLANS.map((p) => {
    const pro = p.id === 'pro';
    const card = (
      <div class={`relative flex h-full flex-col rounded-[20px] p-6 text-fg md:p-8 ${pro
        ? 'pro-card bg-bg'
        : glass
          ? 'bg-bg/88 shadow-[0_40px_80px_-40px_rgb(10_30_80/0.5)] ring-1 ring-black/5 backdrop-blur-xl dark:ring-white/10'
          : 'bg-bg ring-1 ring-line'}`}>
        <div class="flex items-center gap-2.5">
          <span class="text-[15px] font-semibold tracking-[-0.01em]">{p.name}</span>
          {pro && <span class="pill t-blue ml-auto">Most teams</span>}
        </div>

        <!-- What the plan buys, drawn small. -->
        <div class="mt-6 flex h-9 items-center">
          {p.id === 'free' && (
            <span class="flex items-center gap-2.5 text-[12.5px] text-muted" aria-hidden="true">
              <span class="flex size-8 items-center justify-center rounded-full bg-surface text-[11px] font-semibold text-body ring-1 ring-line">You</span>
              One seat, one mailbox
            </span>
          )}
          {pro && (
            <span class="flex items-center gap-3" aria-hidden="true">
              <span class="flex -space-x-1.5">
                {seats.map(([i, bg, fg]) => (
                  <span class="flex size-8 items-center justify-center rounded-full text-[10.5px] font-semibold ring-2 ring-[var(--bg)]" style={`background:${bg};color:${fg}`}>{i}</span>
                ))}
                <span class="flex size-8 items-center justify-center rounded-full bg-surface text-[13px] text-muted ring-2 ring-[var(--bg)]">+</span>
              </span>
              <span class="pill t-green">Viewers free</span>
            </span>
          )}
          {p.id === 'self_hosted' && (
            <CopyCommand class="!h-9 w-full" />
          )}
        </div>

        <div class="mt-6 flex items-baseline gap-2">
          <span class={`font-semibold leading-none tracking-[-0.05em] tabular-nums ${pro ? 'pro-price text-[64px]' : 'text-[52px]'}`}>{p.price}</span>
          <span class="text-[14px] text-muted">{p.unit}</span>
        </div>
        <p class="mt-4 text-[14.5px] leading-relaxed text-muted">{p.blurb}</p>

        <ul class="mt-6 flex-1 space-y-3 border-t border-line pt-6 text-[14px] text-body">
          {p.limits.map((f) => (
            <li class="flex items-start gap-2.5">
              <span class={`mt-px flex size-[18px] shrink-0 items-center justify-center rounded-full ${pro ? 'bg-[color-mix(in_oklab,var(--c-blue)_14%,transparent)] text-[var(--c-blue)]' : 'bg-surface text-fg'}`}><Icon name="check" size={11} stroke={2.6} /></span>
              {f}
            </li>
          ))}
        </ul>

        <a href={p.cta.href} class={`btn btn-lg mt-8 w-full ${pro ? 'pro-btn' : 'btn-ghost'}`}>{p.cta.label}{pro && <Icon name="arrowRight" size={15} />}</a>
      </div>
    );
    return pro ? <div class="pro-ring relative rounded-[22px] p-[2px] lg:-my-4">{card}</div> : card;
  })}
</div>

<style is:global>
  @property --pro-a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .pro-ring {
    --pro-c: conic-gradient(from var(--pro-a), #3b6cf6, #8b5cf6 30%, #22b8cf 55%, #3b6cf6 80%, #8b5cf6);
    background: var(--pro-c);
    animation: pro-turn 9s linear infinite;
  }
  /* The same ring, blurred, as a soft glow behind the card. */
  .pro-ring::before {
    content: '';
    position: absolute;
    inset: 10px;
    z-index: -1;
    border-radius: inherit;
    background: var(--pro-c);
    filter: blur(28px);
    opacity: 0.45;
  }
  .dark .pro-ring::before { opacity: 0.28; }
  @keyframes pro-turn { to { --pro-a: 360deg; } }
  .pro-card {
    background:
      radial-gradient(120% 60% at 50% 0%, color-mix(in oklab, var(--c-blue) 9%, transparent), transparent 70%),
      var(--bg);
  }
  .pro-btn {
    color: #fff;
    background: linear-gradient(180deg, #4a78f7, #2453c2);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 10px 24px -10px rgb(36 83 194 / 0.7);
    transition: filter 160ms, transform 160ms;
  }
  .pro-btn:hover { filter: brightness(1.06); }
  .pro-btn:active { transform: translateY(1px); }
  @media (prefers-reduced-motion: reduce) {
    .pro-ring { animation: none; }
  }
</style>
