---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { LINKS, EMAIL, COMPANY } from '../lib/site';

const cols = [
  {
    title: 'Product',
    links: [
      { href: '/features/#inbox', label: 'Shared inbox' },
      { href: '/features/#chat', label: 'Live chat' },
      { href: '/features/#ai', label: 'AI' },
      { href: '/features/#knowledge-base', label: 'Knowledge base' },
      { href: '/features/#automations', label: 'Automations and SLAs' },
      { href: '/features/#reports', label: 'Reports' },
      { href: '/features/#api', label: 'API and webhooks' },
      { href: '/pricing/', label: 'Pricing' },
      { href: '/download/', label: 'Download' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { href: LINKS.selfHosting, label: 'Self-hosting' },
      { href: '/open-source/', label: 'Why open source' },
      { href: LINKS.github, label: 'GitHub' },
      { href: LINKS.discord, label: 'Discord' },
      { href: `${LINKS.docs}/contributing/`, label: 'Contributing' },
    ],
  },
  {
    title: 'Developers',
    links: [
      { href: LINKS.docs, label: 'Documentation' },
      { href: `${LINKS.docs}/api/`, label: 'API overview' },
      { href: LINKS.apiReference, label: 'API reference' },
      { href: `${LINKS.docs}/api/webhooks/`, label: 'Webhooks' },
      { href: `${LINKS.docs}/api/realtime/`, label: 'Realtime' },
    ],
  },
  {
    title: 'Company',
    links: [
      { href: '/blog/', label: 'Blog' },
      { href: '/security/', label: 'Security' },
      { href: '/contact/', label: 'Contact' },
      { href: '/privacy/', label: 'Privacy' },
      { href: '/terms/', label: 'Terms' },
    ],
  },
];
const year = new Date().getFullYear();
---
<footer class="mt-auto">
  <div class="container-page pb-10 pt-20 md:pt-24">
    <div class="grid gap-12 lg:grid-cols-[1.5fr_repeat(4,1fr)] lg:gap-8">
      <div class="flex flex-col">
        <a href="/" aria-label="opendesk home" class="inline-block w-fit text-fg"><Logo class="h-[20px] w-auto" /></a>
        <p class="mt-5 max-w-[280px] text-[14px] leading-relaxed text-muted">The open-source helpdesk. Run it on our cloud or on your own servers. Same code either way.</p>
        <div class="mt-8 flex w-fit items-center gap-0.5 rounded-full bg-surface-2 p-1 ring-1 ring-line lg:mt-auto" role="radiogroup" aria-label="Theme" data-theme-switch>
          {[
            { v: 'light', icon: 'sun', label: 'Light theme' },
            { v: 'dark', icon: 'moon', label: 'Dark theme' },
            { v: 'system', icon: 'monitor', label: 'System theme' },
          ].map((o) => (
            <button type="button" role="radio" aria-checked="false" data-value={o.v} aria-label={o.label}
              class="inline-flex size-7 items-center justify-center rounded-full text-subtle transition-colors hover:text-fg aria-checked:bg-bg aria-checked:text-fg aria-checked:shadow-[0_1px_2px_rgb(0_0_0/0.08)] aria-checked:ring-1 aria-checked:ring-line">
              <Icon name={o.icon as 'sun'} size={14} />
            </button>
          ))}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-4 lg:contents">
        {cols.map((c) => (
          <div>
            <div class="text-[13px] font-medium text-fg">{c.title}</div>
            <ul class="mt-4 space-y-2.5">
              {c.links.map((l) => (
                <li><a href={l.href} class="text-[14px] text-muted transition-colors hover:text-fg">{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-16 flex flex-col gap-3 border-t border-line pt-6 text-[13px] text-subtle sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div>© {year} opendesk · Apache-2.0</div>
        <div class="mt-1 text-[12px]">{COMPANY.legalName} · registered in {COMPANY.registeredIn}, company no. {COMPANY.number} · {COMPANY.shortAddress}</div>
      </div>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={`mailto:${EMAIL}`} class="hover:text-fg">{EMAIL}</a>
        <a href={LINKS.github} class="hover:text-fg">GitHub</a>
        <a href="/blog/rss.xml" class="hover:text-fg">RSS</a>
      </div>
    </div>
  </div>
</footer>


<script>
  import { applyTheme, currentTheme, type Theme } from '../lib/theme';

  const group = document.querySelector<HTMLElement>('[data-theme-switch]');
  const sync = () => {
    const t = currentTheme();
    group?.querySelectorAll<HTMLButtonElement>('[data-value]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.value === t));
    });
  };
  sync();
  document.addEventListener('od:theme', sync);
  group?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-value]');
    if (b) applyTheme(b.dataset.value as Theme);
  });
</script>
