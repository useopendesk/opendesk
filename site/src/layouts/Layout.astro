---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTA from '../components/CTA.astro';
import type { Props as CtaProps } from '../components/CTA.astro';
import { SITE, LINKS, EMAIL, COMPANY } from '../lib/site';
import { backdrop } from '../lib/backdrops';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** For ogType article: dates and topics, as article:* tags. */
  article?: { published: Date; modified?: Date; tags?: string[] };
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noIndex?: boolean;
  /** The painted closing frame before the footer, or false for none. */
  cta?: CtaProps | false;
  /** The painting above the fold, fetched from <head> before the body is parsed. Match its Backdrop. */
  preload?: { name: string; sizes: string };
}

const {
  title,
  description = SITE.description,
  ogImage = '/og.jpg',
  ogType = 'website',
  article,
  jsonLd,
  noIndex = false,
  cta = {},
  preload,
} = Astro.props;
const hero = preload ? await backdrop(preload.name) : undefined;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).toString();
const fullTitle = title.includes('opendesk') ? title : `${title} · opendesk`;
const ogAbsolute = new URL(ogImage, site).toString();
// public/og.jpg, from `pnpm og`: the hero's app window on its painting.
const ogAlt = 'The opendesk inbox: live chats and email tickets in one queue, with a ticket open beside it.';
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#org`,
  name: 'opendesk',
  legalName: COMPANY.legalName,
  url: SITE.url,
  logo: `${SITE.url}/icon-512.png`,
  email: EMAIL,
  sameAs: [LINKS.github],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: 'opendesk',
  url: SITE.url,
  publisher: { '@id': `${SITE.url}/#org` },
  inLanguage: 'en',
};

// Analytics are a build-time choice: with no key, no script tag is emitted at all.
// Cookieless, no person profiles, no autocapture: pageviews only, never PII.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY ?? '';
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://us.i.posthog.com';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {hero && preload && <link rel="preload" as="image" type="image/avif" imagesrcset={hero.avif} imagesizes={preload.sizes} fetchpriority="high" />}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141416" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="opendesk blog" href="/blog/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="opendesk" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogAbsolute} />
    <meta property="og:image:secure_url" content={ogAbsolute} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1008" />
    <meta property="og:image:alt" content={ogAlt} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    {article && <meta property="article:modified_time" content={(article.modified ?? article.published).toISOString()} />}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbsolute} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(website)} />
    {extra.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}

    <!-- Theme before first paint. White first: dark only when someone chose it (or chose "system" on a dark system). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('od-theme'); } catch (e) {}
        var dark = t === 'dark' || (t === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        d.classList.toggle('dark', dark);
        d.dataset.theme = t || 'light';
      })();
    </script>

    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        window.posthog.init(posthogKey, {
          api_host: posthogHost,
          cookieless_mode: 'always',
          person_profiles: 'never',
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: false,
          disable_session_recording: true,
          mask_all_text: true,
          mask_all_element_attributes: true,
        });
      </script>
    )}
  </head>
  <body class="min-h-dvh flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn btn-primary">Skip to content</a>
    <Header />
    <main id="main" class="relative flex-1">
      <slot />
      {cta && <CTA {...cta} />}
    </main>
    <Footer />
    <script>
      import { initOnscreen } from '../lib/onscreen';
      import { initScenes } from '../lib/scenes';
      initOnscreen();
      initScenes();
    </script>
  </body>
</html>
