---
// The reader's pick wins; until they pick, the docs follow the system's light or dark.
// Inlined to avoid a flash.
---

<script is:inline>
  window.StarlightThemeProvider = (() => {
    const KEY = 'starlight-theme';
    const query = matchMedia('(prefers-color-scheme: dark)');
    const stored = () => {
      try {
        const v = localStorage.getItem(KEY);
        return v === 'dark' || v === 'light' ? v : null;
      } catch {
        return null;
      }
    };
    const apply = () => {
      document.documentElement.dataset.theme = stored() ?? (query.matches ? 'dark' : 'light');
    };
    apply();
    query.addEventListener('change', () => {
      if (stored()) return;
      apply();
      document.dispatchEvent(new CustomEvent('od-theme-change'));
    });
    return { updatePickers() {} };
  })();
</script>
