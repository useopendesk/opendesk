{
  "name": "@opendesk/qa",
  "private": true,
  "description": "QA and recorded proof for pull requests: the checks for what changed, scripted Playwright flows that record stills and walkthrough videos, and the gate CI holds every pull request to",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "qa": "node scripts/qa.ts",
    "proof": "playwright test",
    "share": "node scripts/share.ts",
    "gate": "node scripts/gate.ts",
    "aria": "node scripts/aria.ts",
    "doctor": "node scripts/doctor.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test lib/*.test.ts hooks/*.test.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "typescript": "~7.0.2"
  }
}
